  ],
  "published": "2026-11-23",
  "runtimeMin": 148,
  "format": "Mina Kimes joins for the Nicolas Cage biopic ‘Madden’ and a round of football-movie top fives, then Academy international-feature voter Tracy Letts walks the year's foreign-language contenders.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "What They've Been Watching",
      "note": "to open",
      "films": [
        {
          "title": "You Can See Everything",
          "year": 2025,
          "note": "Nathan Fielder's Elizabeth Holmes doc-about-docs. Kimes, a former investigative business reporter, kept wanting it to ask the question it refuses to; the group's defense is that manipulation is the point."
        },
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "Kimes vaults it into her top four Nolan films, the rare one that gains momentum and peaks in the final third."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Madden’",
      "note": "David O. Russell, straight to Prime",
      "films": [
        {
          "title": "Madden",
          "year": 2026,
          "note": "Cage as John Madden, Christian Bale as Al Davis, Kathryn Hahn, John Mulaney, Shane Gillis, Sienna Miller; shot by Robert Richardson. Three movies crammed into one (70s Raiders, broadcast origin story, video-game startup) and does none well. Cage on a different tonal planet from everyone; the Gillis/Mulaney scenes play like SNL. Dumped on a pre-Thanksgiving Wednesday."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Mina Kimes's Top Five Football Movies",
      "note": "Jerry Maguire just missed — she files it as a rom-com",
      "subject": "football movies",
      "ranked": true,
      "films": [
        {
          "title": "Any Given Sunday",
          "year": 1999,
          "note": "No. 1. Chaotic and stylized but it works; gets at real truths about the sport, and the black-quarterback speech holds up 30 years on."
        },
        {
          "title": "Rudy",
          "year": 1993,
          "note": "Saw it at nine and wept."
        },
        {
          "title": "Friday Night Lights",
          "year": 2004,
          "note": "Peter Berg's best; overshadowed only by the show."
        },
        {
          "title": "Remember the Titans",
          "year": 2000,
          "note": "The Disney sincerity Hollywood stopped attempting."
        },
        {
          "title": "Varsity Blues",
          "year": 1999,
          "note": "The football coheres; strong performances, very rewatchable."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Sean Fennessey's Top Five Football Movies",
      "subject": "football movies",
      "ranked": true,
      "films": [
        {
          "title": "Any Given Sunday",
          "year": 1999,
          "note": "No. 1. End of Oliver Stone's golden era and the best halftime speech in movie history."
        },
        {
          "title": "North Dallas Forty",
          "year": 1979,
          "note": "Nick Nolte dramedy about an aging receiver; shows the bodily toll with 70s grain."
        },
        {
          "title": "Friday Night Lights",
          "year": 2004
        },
        {
          "title": "Horse Feathers",
          "year": 1932,
          "note": "Best Marx Brothers movie, entirely about a college football game; still plays."
        },
        {
          "title": "Necessary Roughness",
          "year": 1991,
          "note": "A deliberate zag: pure college-football comedy loosely on the SMU death penalty."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Amanda Dobbins's Top Five Football Movies",
      "note": "picked for variety, assuming the others would take Any Given Sunday",
      "subject": "football movies",
      "ranked": true,
      "films": [
        {
          "title": "Jerry Maguire",
          "year": 1996,
          "note": "No. 1. Enough textual football (show-me-the-money, the climactic catch) under the rom-com; Regina King underrated."
        },
        {
          "title": "Rudy",
          "year": 1993
        },
        {
          "title": "Heaven Can Wait",
          "year": 1978,
          "note": "Less about football than Warren Beatty and the physics of the afterlife, but the Rams uniforms are cool."
        },
        {
          "title": "Remember the Titans",
          "year": 2000,
          "note": "Young cast, including Ryan Gosling, picking their spots early."
        },
        {
          "title": "School Ties",
          "year": 1992,
          "note": "High-school football and a wild Hollywood-history cast: Fraser, Damon, Affleck, O'Donnell."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "The International Feature Race",
      "note": "with an Academy international-branch voter",
      "guest": "Tracy Letts on",
      "films": [
        {
          "title": "La Bola Negra",
          "year": 2026,
          "note": "The Los Javis' breakthrough, Netflix-backed; best-director and best-actress wins at Cannes. The front-runner and a real Best Picture contender. Getting its own episode."
        },
        {
          "title": "All of a Sudden",
          "year": 2026,
          "note": "Hamaguchi; already a Best Picture threat. The other heavyweight, getting its own episode."
        },
        {
          "title": "Fjord",
          "year": 2026,
          "note": "Palme d'Or winner with Sebastian Stan; a near-lock for a nomination that has oddly dissipated from the race. Uncomfortable by design; debate centers on the final shot."
        },
        {
          "title": "Possible Love",
          "year": 2026,
          "note": "Lee; watched on a plane via Netflix. Elegant, patient class drama that all three admired more than loved; loses the thread in the third act, not as deep as Burning."
        },
        {
          "title": "Beni Mana",
          "year": 2026,
          "note": "Rwanda. Marie-Clémentine Dusabejambo. Post-genocide drama about forgiveness and mothers; feels Mike Leigh-lived-in. Isabel Cabano extraordinary as the AIDS-ravaged sister."
        },
        {
          "title": "Mabanda",
          "year": 2026,
          "note": "Cameroon, Kang Kwentus. Among the bleakest films Letts has seen: a village girl abused and driven to the slums; a tenth of Fjord's budget, strong personal story."
        },
        {
          "title": "Fatherland",
          "year": 2026,
          "note": "Poland, Pawlikowski; third of the trilogy with Ida and Cold War. 72 minutes without credits. Modest, made after a bigger project collapsed, not his grandest statement, and fine for it."
        },
        {
          "title": "Minotaur",
          "year": 2026,
          "note": "France's entry, set in Russia; Andrei Ghenestev remaking Chabrol's The Unfaithful Wife / Lyne's Unfaithful. One extraordinary sequence; Frankensteins a personal plot onto a political one and runs long. Iris Lebedeva compelling."
        },
        {
          "title": "The Dreamed Adventure",
          "year": 2026,
          "note": "Bulgaria, Valeska Grisbach. A 2hr40 hangout: low-level gas deal, rekindled romance, then a shift to an archaeologist's search. Letts's likely No. 1; its non-actor lead is a former croupier."
        },
        {
          "title": "Woman Unknown",
          "year": 2026,
          "note": "Golden Lion winner (whose Venice premiere had to stop over desynced subtitles). A more old-fashioned, stiffer approach; Sean is baffled it won."
        },
        {
          "title": "Coward",
          "year": 2026,
          "note": "Belgium, Lucas Dhont. Two gay soldiers in WWI; leads split Cannes best actor. The trench tension of the first half dissipates once it leaves the front."
        },
        {
          "title": "Rose",
          "year": 2026,
          "note": "Austria, Marcus Schleinzer. Sandra Hüller as a woman living as a man in the 1800s; running best-actress here. Admired over loved; a little fussy and overcranked."
        },
        {
          "title": "No Paradise If You Are Killed by a Woman",
          "year": 2026,
          "note": "Iraq, Halkat Mustafa. A Kurdish female sniper hunting a Swedish sniper; shot in war-torn Mosul. Letts's pick for best sniper movie he's seen."
        },
        {
          "title": "Ang",
          "year": 2026,
          "note": "Nagaland, in Konyak; won the Toronto Platform award, not India's official pick. An old tribal chief resisting a missionary's encroachment, shot on grainy 16mm. Lead Ang Long Konyak is a standup comic in real life."
        },
        {
          "title": "Gandhal",
          "year": 2026,
          "note": "India's official submission; a good movie, but Letts rates Ang the superior film."
        },
        {
          "title": "The Meltdown",
          "year": 2026,
          "note": "Chile. Thumbs up."
        },
        {
          "title": "Rehearsals for a Revolution",
          "year": 2026,
          "note": "UK entry, a documentary in Persian; unseen by the hosts."
        },
        {
          "title": "Silent Friend",
          "year": 2026,
          "note": "Hungary, with Tony Leung and Léa Seydoux. About a tree."
        },
        {
          "title": "Hanging by a Wire",
          "year": 2026,
          "note": "Pakistan. A 75-minute survival doc about boys trapped in a snapped cable car, told with drone footage."
        },
        {
          "title": "Sons of the Neon Knight",
          "year": 2026,
          "note": "Hong Kong. High-concept gun-fu that looks like an anime; makes no sense but a kick."
        },
        {
          "title": "Rokia",
          "year": 2026,
          "note": "Algeria. Demonic-possession horror tying possession to the oppressors' evils; borrows liberally from Poltergeist."
        }
      ]
    }
  ],
