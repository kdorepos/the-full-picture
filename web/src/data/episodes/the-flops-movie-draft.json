  "published": "2026-08-25",
  "runtimeMin": 111,
  "format": "In the dead zone of the release calendar, the crew drafts flops across six categories plus a wildcard: sub-$30M domestic grossers, star bombs, nine-figure losers (adjusted for inflation), Ebert zero-star reviews, sub-25% Rotten Tomatoes, and failed franchise launches. Bill Simmons and Chris Ryan fill out the table. Rule that a movie had to be considered a disappointment at the time; Shawshank got vetoed on those grounds.",
  "segments": [
    {
      "kind": "draft",
      "heading": "The Flops Movie Draft",
      "draftOf": "flops",
      "categories": [
        "Under $30M domestic (wide release)",
        "Star bomb",
        "$100M losers club (adjusted for inflation)",
        "Ebert zero stars",
        "Sub-25% Rotten Tomatoes",
        "Failed franchise launch",
        "Wildcard"
      ],
      "teams": [
        {
          "host": "Sean Fennessey",
          "picks": [
            {
              "title": "Freddy Got Fingered",
              "year": 2001,
              "category": "Ebert zero stars",
              "note": "First overall pick. Ebert: 'This movie doesn't deserve to be mentioned in the same sentence with barrels.' Killed Tom Green's career; Sean saw it in theaters and loved it."
            },
            {
              "title": "Ishtar",
              "year": 1987,
              "category": "Star bomb",
              "note": "Beatty and Hoffman flip parts; sunk by pre-release press more than box office, and it ended Elaine May's directing career."
            },
            {
              "title": "The Last Duel",
              "year": 2021,
              "category": "$100M losers club (adjusted for inflation)",
              "note": "Ridley Scott / Damon / Affleck / Comer; a wrong-time release dead center of the Me Too era."
            },
            {
              "title": "Congo",
              "year": 1995,
              "category": "Sub-25% Rotten Tomatoes",
              "note": "Frank Marshall's Crichton adaptation. 'One of the most fun movies ever made.' Laura Linney, Tim Curry, Amy the gorilla."
            },
            {
              "title": "The Man from U.N.C.L.E.",
              "year": 2015,
              "category": "Failed franchise launch",
              "note": "Guy Ritchie's would-be spy franchise; the Armie Hammer casting keeps it from ever getting revived."
            },
            {
              "title": "The Thing",
              "year": 1982,
              "category": "Under $30M domestic (wide release)",
              "note": "Made ~$3M; a historic bomb. Ceded by Chris after the year cap on the category was dropped."
            },
            {
              "title": "Beloved",
              "year": 1998,
              "category": "Wildcard",
              "note": "Jonathan Demme's Toni Morrison adaptation; a nine-figure loser."
            }
          ]
        },
        {
          "host": "Amanda Dobbins",
          "picks": [
            {
              "title": "How Do You Know",
              "year": 2010,
              "category": "Star bomb",
              "note": "James L. Brooks; Jack Nicholson's last screen role, and where the studio rom-com quietly died."
            },
            {
              "title": "West Side Story",
              "year": 2021,
              "category": "$100M losers club (adjusted for inflation)",
              "note": "Spielberg; lost $104M coming out of COVID. Amanda's No. 3 of the year."
            },
            {
              "title": "North",
              "year": 1994,
              "category": "Ebert zero stars",
              "note": "Ends Rob Reiner's hot streak. Ebert's pan was read aloud at Reiner's roast."
            },
            {
              "title": "Salt",
              "year": 2010,
              "category": "Failed franchise launch",
              "note": "The sequel setup at the end never got made. Angelina Jolie as an action star, never fully tapped."
            },
            {
              "title": "The Lost City of Z",
              "year": 2016,
              "category": "Under $30M domestic (wide release)",
              "note": "James Gray; $40M budget, ~$8M domestic. Sienna Miller's best performance."
            },
            {
              "title": "Sister Act 2: Back in the Habit",
              "year": 1993,
              "category": "Sub-25% Rotten Tomatoes",
              "note": "19% on the tomatometer despite a $125M gross. Lauryn Hill and 'Joyful, Joyful.'"
            },
            {
              "title": "The Girl with the Dragon Tattoo",
              "year": 2011,
              "category": "Wildcard",
              "note": "Also a failed franchise launch; Fincher's would-be trilogy stalled after one."
            }
          ]
        },
        {
          "host": "Bill Simmons",
          "picks": [
            {
              "title": "Police Academy",
              "year": 1984,
              "category": "Ebert zero stars",
              "note": "Ebert had a blind spot for sophomoric comedy; the film spawned six sequels anyway."
            },
            {
              "title": "Cruising",
              "year": 1980,
              "category": "Star bomb",
              "note": "Sent Pacino into his flop era; protested for a year."
            },
            {
              "title": "Manhunter",
              "year": 1986,
              "category": "Under $30M domestic (wide release)",
              "note": "Michael Mann; a bomb at the time, now considered a masterpiece."
            },
            {
              "title": "Ali",
              "year": 2001,
              "category": "$100M losers club (adjusted for inflation)",
              "note": "Great stretches, a dull second half; Mann got overwhelmed telling the whole story."
            },
            {
              "title": "8mm",
              "year": 1999,
              "category": "Sub-25% Rotten Tomatoes",
              "note": "Joel Schumacher; takes off the moment Joaquin Phoenix shows up."
            },
            {
              "title": "Josie and the Pussycats",
              "year": 2001,
              "category": "Failed franchise launch",
              "note": "Anti-corporate girl-group satire from the Can't Hardly Wait team; has a cult now."
            },
            {
              "title": "The Island of Dr. Moreau",
              "year": 1996,
              "category": "Wildcard",
              "note": "Brando visibly counting his cash on screen; Kilmer refusing to be there."
            }
          ]
        },
        {
          "host": "Chris Ryan",
          "picks": [
            {
              "title": "The Assassination of Jesse James by the Coward Robert Ford",
              "year": 2007,
              "category": "Star bomb",
              "note": "$4M domestic for a meditative tone poem scored by Nick Cave; dynamite cast."
            },
            {
              "title": "Furiosa: A Mad Max Saga",
              "year": 2024,
              "category": "$100M losers club (adjusted for inflation)",
              "note": "Lost ~$123M; put the Mad Max franchise on ice."
            },
            {
              "title": "Blackhat",
              "year": 2015,
              "category": "Under $30M domestic (wide release)",
              "note": "Michael Mann; Hemsworth's baffling accent, a Rewatchables staple."
            },
            {
              "title": "Wolf Creek",
              "year": 2005,
              "category": "Ebert zero stars",
              "note": "Ebert: 'I wanted to walk out of the theater and keep on walking.'"
            },
            {
              "title": "Friday the 13th: The Final Chapter",
              "year": 1984,
              "category": "Sub-25% Rotten Tomatoes",
              "note": "Not actually the final chapter; Corey Feldman kills Jason."
            },
            {
              "title": "Master and Commander: The Far Side of the World",
              "year": 2003,
              "category": "Failed franchise launch",
              "note": "Peter Weir's Aubrey-Maturin adaptation that never got a sequel."
            },
            {
              "title": "Battleship",
              "year": 2012,
              "category": "Wildcard",
              "note": "$300M worldwide but only ~$65M domestic; part of the Taylor Kitsch bomb run. Rihanna goes boom."
            }
          ]
        }
      ]
    }
