        },
        {
          "title": "Wild Horse Nine",
          "year": 2026,
          "note": "No. 3: Searchlight, big Malkovich moment, McDonagh track record."
        },
        {
          "title": "Dune: Part Three",
          "year": 2026,
          "note": "No. 4: a known quantity, positioned against 'Doomsday.'"
        },
        {
          "title": "Project Hail Mary",
          "year": 2026,
          "note": "No. 5: Amazon's one big push, reheats for March."
        },
        {
          "title": "Fjord",
          "year": 2026,
          "note": "No. 6: the Palme carries it in."
        },
        {
          "title": "The Invite",
          "year": 2026,
          "note": "No. 7: drip-fed to guilds; strong word of mouth."
        },
        {
          "title": "The Debut",
          "year": 2026,
