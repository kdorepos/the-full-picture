        {
          "title": "Speed",
          "year": 1994,
          "note": "First film job: the guy in the elevator; two weeks downtown, took his dad to the Chinese Theatre for it."
        },
        {
          "title": "Twister",
          "year": 1996,
          "note": "Jan de Bont again; a residual check bigger than any he'd seen."
        },
        {
          "title": "Idiocracy",
          "year": 2006,
          "note": "One half of the smart couple with no kids."
        },
        {
          "title": "Under the Silver Lake",
          "year": 2018,
          "note": "The talisman role Sean ran out of time to raise."
        },
        {
          "title": "Foul Play",
          "year": 1978,
          "note": "Goldie Hawn at the Roadhouse - where he learned actors were real."
        },
        {
          "title": "Private Benjamin",
          "year": 1980
        },
        {
          "title": "Seems Like Old Times",
          "year": 1980
        },
        {
