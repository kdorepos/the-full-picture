{
  "slug": "the-gen-z-movie-takeover-and-the-hunger-games-sunrise-on-the",
  "title": "The Gen Z Movie Takeover and ‘The Hunger Games: Sunrise on the Reaping.’ Plus: ‘Paper Tiger’ With James Gray!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-11-20",
  "runtimeMin": 141,
  "format": "A Hunger Games prequel that reruns the first film, a generational shift toward Gen Z leads, and James Gray's return to the New York crime thriller.",
  "segments": [
    {
      "kind": "review",
      "heading": "‘The Hunger Games: Sunrise on the Reaping’",
      "note": "the weekend's big release",
      "films": [
        {
          "title": "The Hunger Games: Sunrise on the Reaping",
          "year": 2026,
          "note": "158 minutes, sixth in the series; a young Haymitch (Joseph Zada) reruns Katniss's beats. Sean: narratively drained of consequence; Amanda: deathly boring through the first 90 minutes. Jesse Plemons carrying it."
        },
        {
          "title": "The Hunger Games",
          "year": 2012,
          "note": "The original; this prequel essentially remakes its playbook step for step."
        },
        {
          "title": "The Hunger Games: The Ballad of Songbirds & Snakes",
          "year": 2023,
          "note": "The prior prequel; underperformed but had a clearer reason to exist (the origin of Snow)."
        },
        {
          "title": "Battle Royale",
          "year": 2000,
          "note": "Fukasaku's film the whole franchise lifts from."
        },
        {
          "title": "Logan's Run",
          "year": 1976,
          "note": "Blonde male lead on the run from the powers that be; this plot echoes it."
        },
        {
          "title": "Winter's Bone",
          "year": 2010,
          "note": "The steely Jennifer Lawrence power the franchise channeled."
        },
        {
          "title": "The Long Walk",
          "year": 2025,
          "note": "Francis Lawrence's previous film; another young-cast discovery machine (Cooper Hoffman, David Jonsson)."
        },
        {
          "title": "Ghostbusters: Afterlife",
          "year": 2021,
          "note": "McKenna Grace's best fit, doing comic Harold Ramis."
        },
        {
          "title": "Regretting You",
          "year": 2025,
          "note": "Amanda's preferred McKenna Grace mode."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The Gen Z Movie Takeover",
      "note": "the first blockbuster cast entirely with Gen Z leads",
      "films": [
        {
          "title": "Thunderbolts",
          "year": 2025,
          "note": "Sean's control group; its leads (Stan, Harbour, Pullman) aren't Gen Z, which proves the point."
        },
        {
          "title": "The Batman",
          "year": 2022,
          "note": "The new strategy: pay for a known star (Pattinson) rather than launch an unknown."
        },
        {
          "title": "Dune",
          "year": 2021,
          "note": "Overwhelm the audience with the number of cool people."
        },
        {
          "title": "A Minecraft Movie",
          "year": 2025,
          "note": "\"We need Jack Black.\""
        },
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "Tom Holland's bet outside Spider-Man; the hosts think it works."
        },
        {
          "title": "Uncharted",
          "year": 2022,
          "note": "A hit, not good; part of Holland's non-Spidey run."
        },
        {
          "title": "Cherry",
          "year": 2021,
          "note": "Also Holland stretching."
        },
        {
          "title": "Spiderhead",
          "year": 2022,
          "note": "More Holland filmography."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "‘Paper Tiger’",
      "note": "James Gray's new film, seen twice",
      "films": [
        {
          "title": "Paper Tiger",
          "year": 2026,
          "note": "Driver, Johansson, Teller; 1986 Queens brothers pulled toward the Russian mafia. Gray's return to the crime thriller; maybe Driver's best. Amanda: a great version of a thing they admire."
        },
        {
          "title": "Little Odessa",
          "year": 1994,
          "note": "The brothers-ensnared-in-crime template this returns to."
        },
        {
          "title": "We Own the Night",
          "year": 2007,
          "note": "Sean revisited it; the psychology-of-cops movie this extends. The tall-grass sequence redone better here."
        },
        {
          "title": "The Yards",
          "year": 2000,
          "note": "Third of the early crime films in the same frame."
        },
        {
          "title": "Armageddon Time",
          "year": 2022,
          "note": "Where this started, as a direct sequel, before actors changed."
        },
        {
          "title": "Ad Astra",
          "year": 2019,
          "note": "Part of the recent run of films unlike this one."
        },
        {
          "title": "The Lost City of Z",
          "year": 2016,
          "note": "Sean's favorite Gray."
        },
        {
          "title": "The Immigrant",
          "year": 2013
        },
        {
          "title": "Two Lovers",
          "year": 2008,
          "note": "Amanda's favorite."
        },
        {
          "title": "Whiplash",
          "year": 2014,
          "note": "Teller at his best, unsure of himself."
        },
        {
          "title": "The Spectacular Now",
          "year": 2013
        },
        {
          "title": "Rabbit Hole",
          "year": 2010,
          "note": "Early Teller promise."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "James Gray on",
      "films": [
        {
          "title": "Paper Tiger",
          "year": 2026,
          "note": "Built around Hitchcockian suspense with the threat kept off-frame; the Gowanus Canal digitally dropped into the Passaic River as a capitalism metaphor. Shot on 35mm."
        },
        {
          "title": "The Man Who Knew Too Much",
          "year": 1956,
          "note": "The Hitchcock remake he rewatched; catastrophe befalling a \"normal\" family."
        },
        {
          "title": "Notorious",
          "year": 1946,
          "note": "The dark, brooding film Hitchcock made after the war."
        },
        {
          "title": "Vertigo",
          "year": 1958,
          "note": "Stewart replaying his own breakdown; Gray reads it as near-autobiographical."
        },
        {
          "title": "The 39 Steps",
          "year": 1935,
          "note": "The lighter pre-war Hitchcock."
        },
        {
          "title": "Bonnie and Clyde",
          "year": 1967,
          "note": "Benton/Newman wanted Truffaut or Godard first; Europe's influence returning."
        },
        {
          "title": "The Graduate",
          "year": 1967,
          "note": "Mike Nichols, same year, same European lineage."
        },
        {
          "title": "The Godfather",
          "year": 1972,
          "note": "Coppola bringing Italy into the mafia story."
        },
        {
          "title": "Mean Streets",
          "year": 1973,
          "note": "Scorsese and the immigrant feel."
        },
        {
          "title": "Swing Time",
          "year": 1936,
          "note": "George Stevens before the war changed him; one racist sequence aside."
        },
        {
          "title": "A Place in the Sun",
          "year": 1951,
          "note": "The film Stevens couldn't have made before Europe."
        },
        {
          "title": "Rio Bravo",
          "year": 1959,
          "note": "Tarantino idolizes it; the American-director lineage Gray can't work in."
        },
        {
          "title": "Downfall",
          "year": 2004,
          "note": "Ganz's Hitler works because it's Hitler at the end, a mess."
        },
        {
          "title": "From Russia with Love",
          "year": 1963,
          "note": "Robert Shaw's Donald Grant; the Mets' M. Donald Grant joke."
        },
        {
          "title": "The Conformist",
          "year": 1970,
          "note": "Hated it at 19; the dream you hate that tells you something."
        },
        {
          "title": "Samurai Rebellion",
          "year": 1967,
          "note": "He stole the final sequence from it nearly shot for shot."
        },
        {
          "title": "M",
          "year": 1931,
          "note": "Shown to his kids during lockdown; shockingly modern, no setup needed."
        },
        {
          "title": "The Grapes of Wrath",
          "year": 1940,
          "note": "Needed a little Depression context for the kids."
        },
        {
          "title": "I Am a Fugitive from a Chain Gang",
          "year": 1932,
          "note": "A favorite from the lockdown viewings."
        },
        {
          "title": "Applause",
          "year": 1929,
          "note": "Where the chronological lockdown marathon began."
        },
        {
          "title": "Sobibor, October 14, 1943, 4 p.m.",
          "year": 2001,
          "note": "His last-great pick; Lanzmann's Sobibor interview, the axe and the spark on the tooth."
        },
        {
          "title": "Shoah",
          "year": 1985,
          "note": "Shot at the same time as Sobibor."
        }
      ]
    }
  ],
