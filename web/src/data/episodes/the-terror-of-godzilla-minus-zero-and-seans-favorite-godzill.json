{
  "slug": "the-terror-of-godzilla-minus-zero-and-seans-favorite-godzill",
  "title": "The Terror of ‘Godzilla Minus Zero’ and Sean’s Favorite Godzilla Movies. Plus: The Joy of ‘Club Kid,’ With Jordan Firstman!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-11-09",
  "runtimeMin": 129,
  "format": "Godzilla Minus Zero tops the box office, Sean ranks his five favorite Godzilla movies, three more new releases get the verdict, and Jordan Firstman talks through his debut feature Club Kid.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The DC shake-up",
      "note": "movie news",
      "films": [
        {
          "title": "Supergirl",
          "year": 2025,
          "note": "The firing's proximate cause. 'Possibly one of the worst movies of the year,' and a big financial loser."
        },
        {
          "title": "Clayface",
          "year": 2025,
          "note": "'A single to left field.' Gets on base, didn't light the sky up."
        },
        {
          "title": "Man of Tomorrow",
          "note": "Gunn's Superman follow-up, now devalued by his exit before the full rollout."
        },
        {
          "title": "The Batman",
          "year": 2022,
          "note": "Pattinson's Batman; Part II still unmade while the whole Gunn DC era came and went."
        },
        {
          "title": "Ambulance",
          "year": 2022,
          "note": "Floated in the 'maybe Michael Bay takes over' bit; 'rips Optimus Prime.'"
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Godzilla Minus Zero’",
      "note": "No. 1 at the box office",
      "films": [
        {
          "title": "Godzilla Minus Zero",
          "year": 2026,
          "note": "39th Godzilla film, written/directed/VFX by Takashi Yamakaze; King Ghidorah vs. Godzilla in 1949 postwar Japan. Oscar-level effects, but at 2h15m it's baggy. 85% bureaucratic strategy talk, with a felt divide between the monster and human scenes. Highest-grossing non-English film ever to open No. 1 in the U.S."
        },
        {
          "title": "Godzilla Minus One",
          "year": 2023,
          "note": "The surprise predecessor it picks up from; both hosts rate this the stronger, more cohesive film."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Sean's Favorite Godzilla Movies",
      "subject": "Godzilla",
      "ranked": true,
      "films": [
        {
          "title": "Godzilla",
          "year": 1954,
          "note": "No. 1. An Akira Kurosawa-style postwar drama with Godzilla in it; Takashi Shimura stars. 'Not what you think it is.'"
        },
        {
          "title": "Godzilla vs. Biollante",
          "year": 1989,
          "note": "No. 2. Godzilla at war with a giant morphing evolutionary plant. 'Incredibly gross.'"
        },
        {
          "title": "Shin Godzilla",
          "year": 2016,
          "note": "No. 3. Iannucci-grade bureaucratic satire; the monster itself is pure, empathy-free destruction."
        },
        {
          "title": "Destroy All Monsters",
          "year": 1968,
          "note": "The Avengers: Endgame of Godzilla movies; nine guys in suits beating each other up for the final 20 minutes."
        },
        {
          "title": "Mothra vs. Godzilla",
          "year": 1964,
          "note": "Rivals turned friends; picked because Mothra is his daughter's favorite."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Club Kid’",
      "films": [
        {
          "title": "Club Kid",
          "year": 2026,
          "note": "Jordan Firstman writes/directs/stars as Peter, a washed-up party promoter handed a 10-year-old son (Reggie Absalom as Arlo). Shot on 35mm in Chinatown and the Lower East Side. One of Sean's favorites of the year. Classical and new at once, warm and sincere rather than sentimental. Cast includes Cara Delevingne, Kirby Howell-Baptiste, Colleen Camp, Saturn Rising, Miss Benny, Diego Calva."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘The Cat in the Hat’",
      "films": [
        {
          "title": "The Cat in the Hat",
          "year": 2026,
          "note": "Animated; Bill Hader as the Cat, with Matt Berry and Quinta Brunson. 'Fine, not horrible.' Good animation and color, but a Pixar-hangover corporate-bureaucracy frame bolted onto thin source material; the mom material drew complaints. Opened to a soft $20M. Another L for Warner Bros. Animation."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Misty Green’",
      "note": "now on Netflix",
      "films": [
        {
          "title": "Misty Green",
          "year": 2026,
          "note": "Chris Rock writes/directs; Rosalind Eleazar as a fading actress, with Adam Driver, Daniel Kaluuya, Anna Kendrick, Topher Grace, Rock. One of Rock's better movies but mean to everyone except his own character. A muddled, angry Hollywood melodrama that keeps no distance from what it shows, trying to do nine things at once (LA homelessness among them). Skipped VOD straight to Netflix after producer Peter Rice joined."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "Jordan Firstman on",
      "films": [
        {
          "title": "My Own Private Idaho",
          "year": 1991,
          "note": "His last great thing, rewatched on a Delta flight; he sees Club Kid's junkie world and its mix of sentiment and brutality in it."
        },
        {
          "title": "Mysterious Skin",
          "year": 2004,
          "note": "The one overt on-screen reference in Club Kid; a big moment in his life when he first saw it."
        },
        {
          "title": "Kramer vs. Kramer",
          "year": 1979,
          "note": "Mood-board solo-dad template."
        },
        {
          "title": "An Unmarried Woman",
          "year": 1978,
          "note": "Cited repeatedly; a Mazursky touchstone he wishes Criterion would restore."
        },
        {
          "title": "Cruising",
          "year": 1980,
          "note": "On the mood board."
        },
        {
          "title": "Alex in Wonderland",
          "year": 1970,
          "note": "His north star, where he went whenever he didn't know what to do with the camera."
        },
        {
          "title": "Blume in Love",
          "year": 1973,
          "note": "More underseen Mazursky."
        },
        {
          "title": "Hannah and Her Sisters",
          "year": 1986,
          "note": "The affluent-New York fantasy he grew up aspiring to."
        },
        {
          "title": "Birth",
          "year": 2004,
          "note": "Adam Newport-Berra's reference for the adult/child dynamic."
        },
        {
          "title": "Weekend",
          "year": 2011,
          "note": "'Broke me when I saw it'; the sadness and loneliness of the gay experience."
        },
        {
          "title": "Valerian and the City of a Thousand Planets",
          "year": 2017,
          "note": "A Cara Delevingne film he loves; she's 'serving' in it."
        },
        {
          "title": "All of Us Strangers",
          "year": 2023,
          "note": "Where he'd accept Paul Mescal playing gay, though not as Peter."
        }
      ]
    }
  ],
