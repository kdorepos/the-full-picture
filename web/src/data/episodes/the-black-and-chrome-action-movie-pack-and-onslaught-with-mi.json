{
  "slug": "the-black-and-chrome-action-movie-pack-and-onslaught-with-mi",
  "title": "The Black-and-Chrome Action Movie Pack and ‘Onslaught’ With Michael Biehn and Adam Wingard!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Chris Ryan"
  ],
  "published": "2026-09-04",
  "runtimeMin": 115,
  "format": "A metal-adjacent triple bill: streaming-era action programmers, a taxonomy of the 'black-and-chrome' subgenre, then Wingard and Biehn on making one.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The Movie News",
      "note": "with Chris Ryan",
      "films": [
        {
          "title": "Mutiny",
          "year": 2025,
          "note": "Statham as a bodyguard avenging a shipping magnate, on a boat. Accidentally posted to Prime for two hours before release; a plausible dent in a modest box office."
        },
        {
          "title": "The Whisper Man",
          "year": 2025,
          "note": "James Ashcroft serial-killer thriller for Netflix, Fincher-and-Zodiac indebted. De Niro at a whisper, Adam Scott and Michelle Monaghan playing it straight, Hamish Linklater as a bone collector. CR's verdict: should have been a TV show; drags in the final third."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Onslaught’",
      "film": "Onslaught",
      "films": [
        {
          "title": "Onslaught",
          "year": 2025,
          "note": "Wingard's return to guest-verse form: army sniper (Adria Arjona) in a New Mexico trailer park versus escaped super soldiers. A Western at night. Dan Stevens and Rebecca Hall as not-so-crypto-Nazi doctors, Drew Starkey as an MDMA-rolling government fixer, Michael Biehn as Baylor, Eric Wareheim and Reginald VelJohnson around the edges. Not a masterpiece, not trying to be."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The Black-and-Chrome Action Pack",
      "note": "future-feeling, militaristic, fetishistic, souped-up",
      "films": [
        {
          "title": "Mad Max: Fury Road",
          "year": 2015,
          "note": "The Black & Chrome edition gives the whole category its name."
        },
        {
          "title": "The Road Warrior",
          "year": 1981,
          "note": "CR's single best example: the fashion and aesthetic built out of nothing."
        },
        {
          "title": "Terminator 2: Judgment Day",
          "year": 1991,
          "note": "Sean's platonic ideal: leather jackets, souped-up shit, super killers."
        },
        {
          "title": "The Terminator",
          "year": 1984,
          "note": "The dying-cityscape strain, marketed to kids like us."
        },
        {
          "title": "Aliens",
          "year": 1986,
          "note": "Falls right in the middle: colonial marines plus one woman guarding a child."
        },
        {
          "title": "They Live",
          "year": 1988,
          "note": "A comfort movie you rewatch a hundred times."
        },
        {
          "title": "RoboCop",
          "year": 1987,
          "note": "Verhoeven's glimmer of comedy inside the dinginess."
        },
        {
          "title": "Total Recall",
          "year": 1990
        },
        {
          "title": "Big Trouble in Little China",
          "year": 1986,
          "note": "Carpenter falling-asleep-to fare."
        },
        {
          "title": "Prince of Darkness",
          "year": 1987
        },
        {
          "title": "Starship Troopers",
          "year": 1997,
          "note": "Related to Aliens but a distinctly more absurd, comic register."
        },
        {
          "title": "Snowpiercer",
          "year": 2013
        },
        {
          "title": "Vampires",
          "year": 1998,
          "note": "John Carpenter's, way underrated; a cynical band of brothers versus the supernatural."
        },
        {
          "title": "Ghosts of Mars",
          "year": 2001,
          "note": "Carpenter doing Planet of the Vampires by way of Von Ryan's Express; maybe fits the category even harder."
        },
        {
          "title": "Universal Soldier",
          "year": 1992,
          "note": "Early Emmerich, a direct Onslaught ancestor; spawned a VOD paradise of sequels."
        },
        {
          "title": "The Matrix Reloaded",
          "year": 2003,
          "note": "A case for tier one: the highway sequence, Neo's most Arnold performance."
        },
        {
          "title": "Dredd",
          "year": 2012,
          "note": "Tier two."
        },
        {
          "title": "Upgrade",
          "year": 2018,
          "note": "Tier two."
        },
        {
          "title": "Soldier",
          "year": 1998,
          "note": "Kurt Russell; tier two."
        },
        {
          "title": "Terminator Salvation",
          "year": 2009,
          "note": "Lives on for Bale's meltdown, but as much blood-and-chrome as the first two."
        },
        {
          "title": "Predators",
          "year": 2010,
          "note": "Nimrod Antal directs, Rodriguez produces; criminals dropped on a planet."
        },
        {
          "title": "Pitch Black",
          "year": 2000,
          "note": "The Riddick zone."
        },
        {
          "title": "The Chronicles of Riddick",
          "year": 2004
        },
        {
          "title": "V for Vendetta",
          "year": 2005,
          "note": "More politically charged than the rest."
        },
        {
          "title": "John Wick",
          "year": 2014,
          "note": "Works in the tradition, if more elevated and stylized."
        },
        {
          "title": "Ballerina",
          "year": 2025,
          "note": "A self-consciously B-movie Wick; VFX felt unfinished."
        },
        {
          "title": "The Tomorrow War",
          "year": 2021,
          "note": "Tier three; Pratt as teacher turned future super soldier."
        },
        {
          "title": "Without Remorse",
          "year": 2021,
          "note": "An appalling, dull Clancy reboot per Sean; Michael B. Jordan, Sheridan script."
        },
        {
          "title": "Ultraviolet",
          "year": 2006,
          "note": "Milla Jovovich sci-fi action; all the trappings."
        },
        {
          "title": "Aeon Flux",
          "year": 2005,
          "note": "Doesn't quite work but has the trappings."
        },
        {
          "title": "Tron: Legacy",
          "year": 2010,
          "note": "Sixth score, fun to look at, plot forgettable."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "Adam Wingard and Michael Biehn on ‘Onslaught’",
      "guest": "Adam Wingard & Michael Biehn on",
      "films": [
        {
          "title": "Aliens",
          "year": 1986,
          "note": "Wingard's origin story: the out-of-print VHS he rented from a half-Radio Shack video store and watched ~24 times; Biehn's Hicks was the favorite toy."
        },
        {
          "title": "The Terminator",
          "year": 1984,
          "note": "Won its opening weekend, wasn't a top-20 film that year; nobody was clamoring to cast Biehn after."
        },
        {
          "title": "Alien",
          "year": 1979,
          "note": "The tape the half-Radio Shack store had instead of Aliens; young Wingard rented it hunting for the space marines and found none."
        },
        {
          "title": "Alien 3",
          "year": 1992,
          "note": "Just out at the time; the other wrong tape Wingard rented before Tommy tracked down a copy of Aliens."
        },
        {
          "title": "Time Bomb",
          "year": 1991,
          "note": "Avi Nesher B-movie Biehn starred in; its short, primal bursts of action were a stated Onslaught reference. Biehn found it disappointing at the time."
        },
        {
          "title": "The Guest",
          "year": 2014,
          "note": "The film Wingard is most identified with; Onslaught more or less lives in its universe."
        },
        {
          "title": "You're Next",
          "year": 2011
        },
        {
          "title": "Blair Witch",
          "year": 2016
        },
        {
          "title": "Death Note",
          "year": 2017
        },
        {
          "title": "Godzilla vs. Kong",
          "year": 2021,
          "note": "Shot during the pandemic; Wingard started it in a cast after being hit by a car crossing the street outside Simon Barrett's."
        },
        {
          "title": "Godzilla x Kong: The New Empire",
          "year": 2024,
          "note": "The franchise-IP stretch he wanted to step away from."
        },
        {
          "title": "Tombstone",
          "year": 1993,
          "note": "Notoriously director-by-committee (Kevin Jarre out, Cosmatos in, Kurt Russell steering); ignored on release, beloved now. Nobody mentioned Biehn's Johnny Ringo."
        },
        {
          "title": "Navy Seals",
          "year": 1990,
          "note": "Biehn's cautionary tale on saying yes: he confused Lewis Teague with Gene Wilder's credits."
        },
        {
          "title": "The Woman in Red",
          "year": 1984,
          "note": "Gene Wilder's, which Biehn wrongly credited to Teague."
        },
        {
          "title": "Lady in Red",
          "year": 1979,
          "note": "The Lewis Teague film Biehn was actually thinking of."
        },
        {
          "title": "Cujo",
          "year": 1983,
          "note": "The other Teague credit that pushed Biehn to say yes."
        },
        {
          "title": "The Abyss",
          "year": 1989,
          "note": "Biehn told Cameron the third act felt chunky."
        },
        {
          "title": "Grindhouse",
          "year": 2007,
          "note": "First time Biehn recalls being surprised by a soft opening weekend."
        },
        {
          "title": "The Shawshank Redemption",
          "year": 1994,
          "note": "Cited as another film nobody cared about on release."
        },
        {
          "title": "Hit Man",
          "year": 2023,
          "note": "Biehn on Arjona: very sexy, and it worked."
        },
        {
          "title": "Los Frikis",
          "year": 2024,
          "note": "The small Cuba-set film (Biehn calls it 'El Freakos'/'Loose Freakies') Arjona produced and stars in; desperate Cubans injecting HIV to escape. His last-great-thing pick."
        },
        {
          "title": "Pillion",
          "year": 2025,
          "note": "Wingard's pick: a sweet, funny motorcycle-seat romance he compares to the Stevens/Hall dynamic, gay version."
        }
      ]
    }
  ],
