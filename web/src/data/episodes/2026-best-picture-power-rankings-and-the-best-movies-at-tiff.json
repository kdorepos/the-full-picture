    {
      "kind": "review",
      "heading": "‘Resident Evil’",
      "films": [
        {
          "title": "Resident Evil",
          "year": 2026,
          "note": "$60M domestic / $108M global, Cregger's biggest opening. Amanda: 'a really sick movie for the sickos.' Austin Abrams absolutely electric, the shot-a-girl-in-the-face beat the standout."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "Zach Cregger on ‘Resident Evil’",
      "guest": "Zach Cregger on",
      "films": [
        {
          "title": "Resident Evil",
          "year": 2026,
          "note": "Shot nocturnal in the Czech Republic; storyboarded ~97% in advance, rebuilt the lab attack in prep. He reshot the typewriter and the point-blank shotgun beat to get the muzzle flash in frame."
        },
        {
          "title": "Weapons",
          "year": 2025,
          "note": "He went straight from its edit into this; found Abrams there and cast him off that chapter."
        },
        {
          "title": "Flood",
          "year": 2027,
          "note": "His next, written alongside Resident Evil; the 'tombstone' movie he refuses to jump ahead of."
        },
        {
          "title": "Barbarian",
          "year": 2022,
          "note": "The debut he now cringes at over-explaining."
        },
        {
          "title": "Irreversible",
          "year": 2002,
          "note": "Fire-extinguisher scene as a peak of movie violence."
        },
        {
          "title": "Los Bastardos",
          "year": 2008,
          "note": "Amat Escalante; the point-blank shotgun kill he was chasing in Resident Evil."
        },
        {
          "title": "Dead Mail",
          "year": 2024,
          "note": "His last-great-thing pick, a Shudder true-crime film."
        },
        {
          "title": "Night of the Living Dead",
          "year": 1968,
          "note": "Romero not lecturing about Vietnam and race as the model for not over-explaining theme."
