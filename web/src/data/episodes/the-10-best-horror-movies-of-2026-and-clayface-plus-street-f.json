    {
      "kind": "interview",
      "heading": "‘Street Fighter’",
      "guest": "Shea Serrano on",
      "films": [
        {
          "title": "Street Fighter",
          "year": 2026,
          "note": "Trailer-duped both of them. Ryu barely fights, Bison's a weasel, the tournament is a fake-out, and there's almost no street fighting. A 4.5 out of 10. Great 90s needle drops stitched like music videos over a story they never crack."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "Shea Serrano's Best Movie Fight Scenes",
      "note": "one guest, his picks",
      "picks": [
        {
          "title": "The Way of the Dragon",
          "year": 1972,
          "by": "Shea Serrano",
          "note": "Bruce Lee vs. Chuck Norris, the blueprint. The chest-hair pluck, the kick into the camera. His likely No. 1."
        },
        {
          "title": "The Raid 2",
          "year": 2014,
          "by": "Shea Serrano",
          "note": "The kitchen fight. Iko Uwais, seven uninterrupted minutes. The best ever put to film."
        },
        {
          "title": "Mortal Kombat",
          "year": 1995,
          "by": "Shea Serrano",
          "note": "Johnny Cage vs. Scorpion. Makes no sense, but delivers the game better than the new Street Fighter does."
        },
        {
          "title": "The Protector",
          "year": 2005,
          "by": "Shea Serrano",
          "note": "Tony Jaa's four-minute stair tracking shot against 40 guys."
        },
        {
          "title": "John Wick: Chapter 3 - Parabellum",
          "year": 2019,
          "by": "Shea Serrano",
          "note": "2-on-1 against the Raid's Yayan Ruhian and Cecep Arif Rahman, an homage that lets them beat up John."
        },
        {
          "title": "Crouching Tiger, Hidden Dragon",
          "year": 2000,
          "by": "Shea Serrano",
          "note": "Zhang Ziyi vs. Michelle Yeoh; a Best Picture nominee this violent."
        },
        {
          "title": "Undisputed II: Last Man Standing",
          "year": 2006,
          "by": "Shea Serrano",
          "note": "Chambers vs. Yuri Boyka; Scott Adkins and Michael Jai White at their best."
        },
        {
          "title": "Drunken Master II",
          "year": 1994,
          "by": "Shea Serrano",
          "note": "Jackie Chan vs. Ken Lo; comic chops plus the best leg work."
        },
        {
          "title": "Bloodsport",
          "year": 1988,
          "by": "Shea Serrano",
          "note": "Frank Dukes vs. Chong Li; remedial good-versus-bad storytelling, Van Damme at his best."
        },
        {
          "title": "Ip Man",
          "year": 2008,
          "by": "Shea Serrano",
          "note": "The ten black belts; Donnie Yen looks like he's eating a sandwich in the park."
        }
      ]
    }
