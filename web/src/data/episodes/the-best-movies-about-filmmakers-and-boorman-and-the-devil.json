          "year": 2014
        },
        {
          "title": "The Island of Dr. Moreau",
          "year": 1996,
          "note": "Brando and Kilmer on one island: two maniacs, one doomed shoot."
        },
        {
          "title": "American Movie",
          "year": 1999,
          "note": "Chris Smith on Mark Borchardt; bigger ideas about family and the American artist. One of Sean's favorites."
        },
        {
          "title": "George Stevens: A Filmmaker's Journey",
          "year": 1984,
          "note": "By Stevens Jr.; oddly given a 4K upgrade."
        },
        {
          "title": "Shane",
          "year": 1953
        },
        {
          "title": "Giant",
          "year": 1956
        },
        {
          "title": "Directed by John Ford",
          "year": 1971,
          "note": "Bogdanovich; a portrait of an artist performing disinterest, plus backyard interviews with Wayne, Stewart and Fonda."
        },
        {
          "title": "Hal",
          "year": 2018,
          "note": "On Hal Ashby; Letts's happy place, two hours of smart people on a career."
        },
        {
          "title": "Runnin' Down a Dream",
          "year": 2007,
          "note": "Bogdanovich's Tom Petty doc."
        },
        {
          "title": "Friedkin Uncut",
          "year": 2018,
          "note": "Two hours of ornery Friedkin, who held Boorman in contempt for cashing in on ‘The Exorcist.’ Letts declined an interview for it."
        },
        {
          "title": "De Palma",
          "year": 2015,
          "note": "Baumbach and Paltrow, camera fixed on De Palma going film by film. Sean's nightlight."
        },
        {
          "title": "Hitchcock/Truffaut",
          "year": 2015,
          "note": "Kent Jones; you can see how the Finchers and James Grays absorbed the book into their work."
        },
        {
          "title": "Magician: The Astonishing Life and Work of Orson Welles",
          "year": 2014,
          "note": "Comprehensive but a little dry."
        },
        {
          "title": "78/52",
