        },
        {
          "title": "Heart of the Beast",
          "year": 2026,
          "note": "Brad Pitt dog movie they'll cover next week."
        },
        {
          "title": "Slay Ground",
          "year": 2026,
          "note": "Jeremy Saulnier's next, teased with a Blair Witch-style surveillance clip and a runlikehell.com countdown; previously titled 'October.'"
        },
        {
          "title": "You Can See Everything",
          "year": 2026,
          "note": "A24 surprise-release play for the fall."
        },
        {
          "title": "The Chronicles of Narnia: The Magician's Nephew",
          "year": 2026,
          "note": "Greta Gerwig's version, moved to 1950s London with a rock-opera vibe; Meryl Streep as Aslan. Feb 12, wide."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "Adam Naiman's TIFF report",
      "guest": "Adam Naiman on",
      "films": [
        {
          "title": "La Bola Negra",
          "year": 2026,
          "note": "People's Choice Award winner, first Netflix film to take it. Los Javis won Best Director at Cannes."
        },
        {
          "title": "Elsinore",
          "year": 2026,
          "note": "International PCA winner. Andrew Scott performance buried under over-cut direction in the home stretch."
        },
        {
          "title": "Being Human",
          "year": 2026,
          "note": "Opening-night film, third in PCA voting."
        },
        {
          "title": "Every Time",
          "year": 2026,
          "note": "Sandra Wollner. Adam's favorite by a mile; mysterious, After Sun-adjacent (same cinematographer). Germany's Oscar submission."
        },
        {
          "title": "Possible Love",
          "year": 2026,
          "note": "Lee Chang-dong. Closer to 'Burning' than 'Parasite'; strong second half, odd audience laughter."
        },
        {
          "title": "Josephine",
          "year": 2026,
          "note": "Beth de Araújo, with Channing Tatum and Gemma Chan. Mixed on the literal haunting; applause breaks it wasn't built for."
        },
        {
          "title": "River",
          "year": 2026,
          "note": "Josh Ruben-ish slasher, ~$8M to Blumhouse/Universal. Jessica Rothe and Jane Levy; the one genre film Adam liked."
        },
        {
          "title": "Club Kid",
          "year": 2026,
          "note": "Jordan Firstman. Sean and Amanda are in the bag; Adam finds it effective but shallow and self-flattering."
        },
        {
          "title": "The Debut",
          "year": 2026,
          "note": "Telluride applause film; also not for Adam."
        },
        {
          "title": "I Play Rocky",
          "year": 2026,
          "note": "Peter Farrelly. Prohibitive PCA favorite, came in second. Craft-of-acting piece; Tracy Letts as the studio guy."
        },
        {
          "title": "Ink",
          "year": 2026,
          "note": "Danny Boyle heckled over pointless generative AI."
        },
        {
          "title": "Minotaur",
          "year": 2026,
          "note": "Polite Cannes reception, not rapturous."
        },
        {
          "title": "Fjord",
          "year": 2026,
          "note": "Palme d'Or, Neon; didn't go over in Toronto."
        },
        {
          "title": "Behemoth",
          "year": 2026,
          "note": "Searchlight; playing NYFF, Adam hasn't seen it."
        },
        {
          "title": "Paper Tiger",
          "year": 2026,
          "note": "James Gray opens NYFF, skipped the festival machine."
        },
        {
          "title": "Prime Time",
          "year": 2026
        },
        {
          "title": "Everything Else Is Noise",
          "year": 2026,
          "note": "Nico Pareto, Wavelength section."
        },
        {
          "title": "The Remotes",
          "year": 2026,
          "note": "John Torres; 'vaporwave Filipino Cronenberg.'"
        }
      ]
    },
