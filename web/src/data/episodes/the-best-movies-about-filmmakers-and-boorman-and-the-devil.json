{
  "slug": "the-best-movies-about-filmmakers-and-boorman-and-the-devil",
  "title": "The Best Movies About Filmmakers, and ‘Boorman and the Devil’",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Tracy Letts"
  ],
  "published": "2026-09-23",
  "runtimeMin": 103,
  "format": "Sean Fennessey and Tracy Letts review the documentary ‘Boorman and the Devil,’ then survey docs and features that portray film directors at work.",
  "segments": [
    {
      "kind": "review",
      "heading": "‘Boorman and the Devil’",
      "note": "David Kittredge's doc on John Boorman's ‘Exorcist II’",
      "films": [
        {
          "title": "Boorman and the Devil",
          "year": 2025,
          "note": "Kittredge's portrait of Boorman and his misbegotten ‘Exorcist’ sequel. Letts: catnip for film dorks, mostly heads and clips with faux-zippy animated recreations; not a great doc, but a great subject."
        },
        {
          "title": "Exorcist II: The Heretic",
          "year": 1977,
          "note": "Both agree it's awful and, fatally, not scary. Praise reserved for Ennio Morricone's score (Boorman had him strip the melodic element) and its downstream influence on Italian horror. A worthy curiosity, best watched right before the doc."
        },
        {
          "title": "The Exorcist",
          "year": 1973,
          "note": "Friedkin's documentary-realist approach, the opposite of Boorman's myth-and-symbol instincts; a claim on scariest film ever made. Boorman turned down directing it."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "John Boorman's filmography",
      "note": "the second-tier British master",
      "films": [
        {
          "title": "Deliverance",
          "year": 1972,
          "note": "Five-star masterpiece; the blank check that let him make Zardoz. Voight and Reynolds's best; Ned Beatty and Ronny Cox's film debuts. Letts disputes Tarantino's gripe about casting Dickey as the sheriff."
        },
        {
          "title": "Point Blank",
          "year": 1967,
          "note": "Game-changing, prismatic L.A. crime film that redefined the noir."
        },
        {
          "title": "Zardoz",
          "year": 1974,
          "note": "Connery in a mankini; a cult sci-fi fantasia. One of Sean's physical-media white whales, out of print on Arrow/Twilight Time."
        },
        {
          "title": "Hell in the Pacific",
          "year": 1968,
          "note": "Mifune vs. Marvin; ruined for years by pan-and-scan that placed them on opposite edges of the Panavision frame."
        },
        {
          "title": "Excalibur",
          "year": 1981,
          "note": "His return to form after ‘The Heretic.’"
        },
        {
          "title": "Hope and Glory",
          "year": 1987,
          "note": "Warm, autobiographical WWII childhood film; Roger Avary's favorite Boorman."
        },
        {
          "title": "The General",
          "year": 1998,
          "note": "Irish crime film on Martin Cahill, with Gleeson and a Voight reunion."
        },
        {
          "title": "The Tailor of Panama",
          "year": 2001,
          "note": "le Carré adaptation; the studio reportedly reshot Boorman's ending in which Rush's character kills Brosnan's."
        },
        {
          "title": "Catch Us If You Can",
          "year": 1965,
          "note": "His Dave Clark Five debut, already a satire of the pop-machine that spawned it."
        },
        {
          "title": "In My Country",
          "year": 2004,
          "note": "One of Boorman's 2000s films Sean hasn't caught up with."
        },
        {
          "title": "The Tiger's Tail",
          "year": 2006,
          "note": "Another of the mid-2000s Boorman films Sean hasn't seen; he kept working up to 2014."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "Documentaries about filmmakers",
      "films": [
        {
          "title": "Hearts of Darkness: A Filmmaker's Apocalypse",
          "year": 1991,
          "note": "Eleanor Coppola's record of Coppola taking the failure onto himself; the alpha of the everything-goes-wrong doc."
        },
        {
          "title": "Apocalypse Now",
          "year": 1979
        },
        {
          "title": "Burden of Dreams",
          "year": 1982,
          "note": "Les Blank on Herzog; the omega of the crisis doc. Both directors knew the buck stopped with them."
        },
        {
          "title": "Fitzcarraldo",
          "year": 1982
        },
        {
          "title": "The Ghost of Peter Sellers",
          "year": 2018,
          "note": "Peter Medak reckoning with his aborted pirate comedy and his own share of the blame, echoing Boorman's."
        },
        {
          "title": "The Ruling Class",
          "year": 1972,
          "note": "Medak's earlier success with Sellers and O'Toole."
        },
        {
          "title": "Jodorowsky's Dune",
          "year": 2013,
          "note": "A what-if on an unmade film; a fantasia of ideas too big to realize."
        },
        {
          "title": "Best Worst Movie",
          "year": 2009,
          "note": "Sean's pick for the doc that shifted expectations toward loving a failure."
        },
        {
          "title": "Troll 2",
          "year": 1990,
          "note": "Not a sequel to ‘Troll’; a lovable fiasco set in Nilbog."
        },
        {
          "title": "Troll",
          "year": 1986
        },
        {
          "title": "The Kingdom of Dreams and Madness",
          "year": 2013,
          "note": "On Studio Ghibli."
        },
        {
          "title": "Hayao Miyazaki and the Heron",
          "year": 2024,
          "note": "The NHK doc released alongside the feature."
        },
        {
          "title": "Ingmar Bergman Makes a Movie",
          "year": 1963,
          "note": "Workman-like Bergman in the flow on ‘Winter Light’; dry but procedurally revealing."
        },
        {
          "title": "Winter Light",
          "year": 1962
        },
        {
