{
  "slug": "the-gene-hackman-hall-of-fame-2026",
  "title": "The Gene Hackman Hall of Fame",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins",
    "Tracy Letts"
  ],
  "published": "2026-11-03",
  "runtimeMin": 181,
  "format": "Three hosts walk Gene Hackman's entire filmography film by film and settle on the 10 that make his Hall of Fame.",
  "segments": [
    {
      "kind": "halloffame",
      "heading": "The Gene Hackman Hall of Fame",
      "honoree": "Gene Hackman",
      "films": [
        {
          "title": "Bonnie and Clyde",
          "year": 1967,
          "note": "Buck Barrow, Clyde's dumb older brother; his first Oscar nomination and a real performance, accent and all."
        },
        {
          "title": "The French Connection",
          "year": 1971,
          "note": "Popeye Doyle, the Oscar win that minted him. He was the 8th-to-14th choice and begged off the picture; Sean calls it a five-star masterpiece."
        },
        {
          "title": "Scarecrow",
          "year": 1973,
          "note": "Max, the drifter who wants to open a car wash, opposite Pacino. Funny open, devastating finish."
        },
        {
          "title": "The Conversation",
          "year": 1974,
          "note": "Harry Caul; a whole inner life carried with barely any dialogue. Not even Oscar-nominated the year Art Carney won."
        },
        {
          "title": "Night Moves",
          "year": 1975,
          "note": "Harry Mosby, seedy detective in an anti-mystery. Bombed opposite Jaws; rewards the rewatch."
        },
        {
          "title": "Superman",
          "year": 1978,
          "note": "Lex Luthor, broad and gleeful. The template for the arch-villain comedy he'd keep returning to."
        },
        {
          "title": "Unforgiven",
          "year": 1992,
          "note": "Little Bill Daggett; his second Oscar. Sadism undergirded by real charm. He didn't want to make a violent picture."
        },
        {
          "title": "The Firm",
          "year": 1993,
          "note": "Avery Tolar; the emotional depth the conspiracy plot would otherwise lack. Horny Hackman, flawed and sensitive."
        },
        {
          "title": "Crimson Tide",
          "year": 1995,
          "note": "Capt. Ramsey, electrifying against Denzel. Tracy dissents on the limp coda; the sub is green anyway."
        },
        {
          "title": "The Royal Tenenbaums",
          "year": 2001,
          "note": "Royal; one of his very best, and the friction that later Wes Anderson arguably lost. He hated making it."
        }
      ]
    }
  ],
