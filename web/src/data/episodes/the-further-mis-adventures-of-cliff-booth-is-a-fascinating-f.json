    {
      "kind": "review",
      "heading": "‘The Further Mis-Adventures of Cliff Booth’",
      "note": "Fincher directs, Tarantino writes",
      "films": [
        {
          "title": "The Further Mis-Adventures of Cliff Booth",
          "year": 2026,
          "note": "Set in 1977, eight years after Once Upon a Time in Hollywood. Brad Pitt is back as Cliff, now a bartender, movie-theater projectionist, and off-the-books studio fixer. Tarantino's comic timing runs up against Fincher's unflinching violence, and the result works as a hangout movie, a detective story, and a romance with some of the best bar scenes either has shot. Elizabeth Debicki is the standout. Scott Caan channels his father James Caan as TV star Charlie Peters. An AI-use controversy broke on Twitter after early screenings. Two weeks on about 200 IMAX screens, then Netflix at Christmas."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "David Fincher on",
      "films": [
        {
          "title": "The Further Mis-Adventures of Cliff Booth",
          "year": 2026,
          "note": "Made because Tarantino cleared the rails and Pitt wanted it; Fincher signed on for two scenes (the twink/chicken-hawk opener and the balcony). Scanned digital out to film for grain and gate weave. Tightrope, manipulated through an AM receiver, scores the finale after Boston passed."
        },
        {
          "title": "Butch Cassidy and the Sundance Kid",
          "year": 1969,
          "note": "The making-of doc, more than the film, is what made eight-year-old Fincher want to direct; its final photo pullback inspired the montages here."
        },
        {
          "title": "The Sting",
          "year": 1973,
          "note": "George Roy Hill, his favorite director growing up; saw it ~35 times, lamented Conrad Hall's absence."
        },
        {
          "title": "Gone Girl",
          "year": 2014,
          "note": "Built on a rom-com chassis; the 'spa music' brief to Reznor and Ross. Offered as proof you can't sell tone in two minutes."
        },
        {
          "title": "Weapons",
          "year": 2025,
          "note": "Fincher mentored Zach Cregger, sent 700 Pix notes; calls the first hour as good as anything on a building-blocks level."
        }
      ]
    }
  ],
