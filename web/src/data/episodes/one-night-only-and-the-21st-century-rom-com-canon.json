    {
      "kind": "review",
      "heading": "'One Night Only'",
      "films": [
        {
          "title": "One Night Only",
          "year": 2025,
          "note": "Will Gluck directs a Travis Braun blacklist script: two strangers chase love on the one night a year premarital sex is legal. Barbaro and Turner are charming, the jokes land, it's shot in real New York with a real soundtrack. But the purge-but-sex premise never sells, and 'let's not let the mandate win' pulls you right back to the holes. Amanda: almost works. Juliette: had a good time."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "The 21st Century Rom-Com Canon",
      "note": "2001-2026, structural rules strictly applied; one personal 'blue' pick each",
      "picks": [
        {
          "title": "Bridget Jones's Diary",
          "year": 2001,
          "note": "Unassailable. Richard Curtis via Helen Fielding via Austen; Zellweger Oscar-nommed."
        },
        {
          "title": "The Wedding Planner",
          "year": 2001,
          "note": "Juliette's favorite McConaughey; a good San Francisco movie, immoral setup and all."
        },
        {
          "title": "My Big Fat Greek Wedding",
          "year": 2002,
          "note": "A $241M sensation; cultural weight forces it in."
        },
        {
          "title": "Sweet Home Alabama",
          "year": 2002,
          "note": "$180M; lightning-in-a-bottle motif and Melanie Lynskey as the friend."
        },
        {
          "title": "How to Lose a Guy in 10 Days",
          "year": 2003,
          "note": "Retrograde and a little gross for women, but endlessly quoted and memed, so it's in."
        },
        {
          "title": "Something's Gotta Give",
          "year": 2003,
          "note": "Nancy Meyers; over-40 leads, coastal-grandma production design, not picking Keanu."
        },
        {
          "title": "Hitch",
          "year": 2005,
          "note": "Two romances landed at once; $179M; Juliette's favorite Will Smith."
        },
        {
          "title": "Wedding Crashers",
          "year": 2005,
          "note": "$209M; more friend/con-man movie than rom-com but the bones are there."
        },
        {
          "title": "Knocked Up",
          "year": 2007,
          "note": "The bro-com pivot point; essential even if not beloved."
        },
        {
          "title": "27 Dresses",
          "year": 2008,
          "note": "You need a Katherine Heigl in the mix, the sign of trouble to come."
        },
        {
          "title": "Forgetting Sarah Marshall",
          "year": 2008,
          "note": "Brought new blood to a dying genre; Craig Horlbeck's touchstone."
        },
        {
          "title": "The Proposal",
          "year": 2009,
          "note": "$164M, arguably the last box-office rom-com sensation."
        },
        {
          "title": "Morning Glory",
          "year": 2010,
          "note": "The pair's most underrated pick; a great Hunter Boots / Rockefeller Plaza movie."
        },
        {
          "title": "Silver Linings Playbook",
          "year": 2012,
          "note": "Launched J-Law to an Oscar; Amanda's husband's #1."
        },
        {
          "title": "Trainwreck",
          "year": 2015,
          "note": "Apatow directs a woman; $100M+; Jack's teenage favorite."
        },
        {
          "title": "The Big Sick",
          "year": 2017,
          "note": "Screenplay Oscar nom; ushers in the smaller, sadder streaming-era rom-com."
        },
        {
          "title": "Set It Up",
          "year": 2018,
          "note": "The Netflix original adults actually talked about; helped Glen Powell."
        },
        {
          "title": "Happiest Season",
          "year": 2020,
          "note": "One of the few non-straight entries; everyone wanted Stewart to pick Aubrey Plaza."
        },
        {
          "title": "Palm Springs",
          "year": 2020,
          "note": "Inventive Sundance hit; in despite Juliette's aversion to sun-drenched pool movies."
        },
        {
          "title": "Anyone But You",
          "year": 2023,
          "note": "Also Gluck; a rare wide theatrical rom-com hit. Canonical, not good."
        },
        {
          "title": "Anora",
          "year": 2024,
          "note": "Best Picture winner leaning on screwball; too good to not claim."
        },
        {
          "title": "Pillion",
          "year": 2025,
