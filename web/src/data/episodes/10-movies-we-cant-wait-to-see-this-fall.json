  "title": "10 Movies We Can’t Wait to See This Fall",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-09-01",
  "runtimeMin": 89,
  "format": "The fall preview: five most-anticipated titles apiece, plus what they've already seen and recommend, and a September stab at the Oscar nominations.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The box office and the news",
      "films": [
        {
          "title": "Coyote vs. Acme",
          "year": 2026,
          "note": "Dumped by Warner Bros. in 2023 as a Zaslav tax write-off, rescued by Ketchup Entertainment for a reported $50M; opened to $15.5M. Sean soft-recommends it as a legal comedy for the 8 to 12 set."
        },
        {
          "title": "Spider-Man: Brand New Day",
          "year": 2026,
          "note": "Fifth weekend at No. 1 (~$22M), and it fell just short of a domestic billion. Now one of the biggest movies ever made."
        },
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "Nolan's; third place at ~$14M eight weeks in, ~$560M domestic and ~$1.8B worldwide, heavy Best Picture favorite that has cleared the prestige board."
        },
        {
          "title": "Buddy",
          "year": 2026,
          "note": "Caspar Kelly's horror riff on Barney and Pee-Wee's Playhouse; ~$6M on ~1,000 screens, a big number for the type."
        },
        {
          "title": "The Dog Stars",
          "year": 2026,
          "note": "Ridley Scott's $100M post-apocalyptic film; ~$8M domestic, ~$19M worldwide. Last week's episode subject, and a notable box-office miss."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "10 Movies We Can't Wait to See This Fall",
      "note": "five apiece, counted down",
      "picks": [
        {
          "title": "Digger",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "His No. 1. Iñárritu's Strangelovean Tom Cruise satire for Warner Bros.; wants it to be good but isn't an Iñárritu person, so expectations are lowered."
        },
        {
          "title": "The Further Misadventures of Cliff Booth",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Fincher directs, Tarantino scripts, Brad Pitt returns as Cliff Booth. IMAX-only via Netflix, barely marketed since the Super Bowl teaser; Peter Weller plays Booth's father."
        },
        {
          "title": "Resident Evil",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Zach Cregger adapts the game; Austin Abrams over one night as the outbreak begins. Sean likes knowing nothing about it."
        },
        {
          "title": "Elsinore",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Simon Stone directs Andrew Scott and Olivia Colman, based on actor Ian Charleson playing Hamlet while dying of AIDS. Whispered Andrew Scott nomination."
        },
        {
          "title": "Whale Fall",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Brian Duffield adapts Daniel Kraus's novel; Austin Abrams swallowed by a whale, Josh Brolin as the survivalist father."
        },
        {
          "title": "Artificial",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Her No. 1. Guadagnino's Sam Altman/OpenAI movie, Andrew Garfield, script by Simon Rich. Dropped by Amazon, picked up by Neon."
        },
        {
          "title": "Primetime",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Lance Oppenheim's To Catch a Predator film; Robert Pattinson as Chris Hansen."
        },
        {
          "title": "Verity",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Michael Showalter's Colleen Hoover adaptation; Anne Hathaway, Dakota Johnson, Josh Hartnett. Script by Nick Antosca."
        },
        {
          "title": "Ink",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Danny Boyle on Rupert Murdoch buying The Sun; Guy Pearce, Jack O'Connell, Claire Foy. Opening night of Venice."
        },
        {
          "title": "Making Marie Antoinette",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Set doc from Sofia Coppola's Marie Antoinette, mostly shot by her late mother Eleanor Coppola and finished by Sofia; at NYFF for the film's 20th anniversary."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "Honorable mentions",
      "picks": [
        {
          "title": "Dune: Part Three",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Everything he's seen he's loved; the opening was dynamite."
        },
        {
          "title": "The Debut",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Jesse Eisenberg musical about staging a community-theater musical; Julianne Moore, Paul Giamatti. A24, likely Telluride."
        },
        {
          "title": "Misty Green",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Chris Rock directs; Rosalind Eleazar, plus Adam Driver, Daniel Kaluuya, Anna Kendrick, Topher Grace. TIFF."
        },
        {
          "title": "Behemoth",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Tony Gilroy; Pedro Pascal as a cellist, Olivia Wilde, Will Arnett, Ava Victor. Nine composers wrote the in-film scores."
        },
        {
          "title": "Other Mommy",
          "year": 2026,
          "by": "both",
          "note": "Jessica Chastain vs. a phantasmagorical second mother; the jump-scare trailer of the year."
        },
        {
          "title": "Street Fighter",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Best of the CinemaCon game presentations; Noah Centineo as Ken."
        },
        {
          "title": "Possible Love",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Lee Chang-dong's first since Burning; Netflix awards hopeful, a rare non-Cannes international feature in the race."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "Seen it, recommend it",
      "note": "three apiece",
      "picks": [
        {
          "title": "Paper Tiger",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "James Gray; Miles Teller, Adam Driver, Scarlett Johansson. NYFF; a very James Gray movie, best Teller in years."
        },
        {
          "title": "The Only Living Pickpocket in New York",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Noah Segan directs John Turturro as an aging analog pickpocket; Buscemi, Esposito. Tight 85 minutes, Sundance, Sony Pictures Classics."
        },
        {
          "title": "Fjord",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Mungiu's Palme d'Or winner; Sebastian Stan, Renate Reinsve. Divisive; Sean's favorite from Cannes."
        },
        {
          "title": "The History of Concrete",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "John Wilson's feature debut, literally the history of the material and far more emotional than it sounds."
        },
        {
          "title": "Club Kid",
          "year": 2026,
          "by": "Amanda Dobbins",
          "note": "Jordan Firstman; an aging club kid discovers he has a son. Diego Calva. A24, November; Amanda's favorite at Cannes."
        },
        {
          "title": "All of a Sudden",
          "year": 2026,
          "by": "Sean Fennessey",
          "note": "Hamaguchi's 3.5-hour elder-care epic; Virginie Efira, Tao Okamoto. Thanksgiving."
        }
      ]
    },
