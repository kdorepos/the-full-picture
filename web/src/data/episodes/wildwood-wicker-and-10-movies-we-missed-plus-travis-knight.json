{
  "slug": "wildwood-wicker-and-10-movies-we-missed-plus-travis-knight",
  "title": "'Wildwood,' 'Wicker,' and 10 Movies We Missed! Plus: Travis Knight!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins",
    "Joanna Robinson"
  ],
  "published": "2026-10-30",
  "runtimeMin": 156,
  "format": "Joanna Robinson joins for an Oscar-season check-in, then a run through the fall releases the show skipped, and Wildwood director Travis Knight on his 16 years of stop-motion.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "Oscar-season check-in",
      "note": "with Joanna Robinson",
      "films": [
        {
          "title": "Dune: Part Three",
          "year": 2026,
          "note": "Trailer talk: a Vietnam-war register, heavy on Zendaya, maybe a Return of the King-style trilogy crown. Zendaya is running for Best Actress."
        },
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "Nolan's long-presumed frontrunner; Universal is holding it back to re-release his films and bring it back later. Skipped the Gothams."
        },
        {
          "title": "You Can See Everything",
          "year": 2026,
          "note": "Nathan Fielder/Lance Oppenheim docudrama that's done over $50M at the box office; the DGA ruled it ineligible for Best Director, though it stays Best Picture eligible."
        },
        {
          "title": "La Bola Negra",
          "year": 2026,
          "note": "Netflix Spanish Civil War epic; Sean thinks it's over-indexed coming out of the festivals, and liked it apart from the modern story."
        },
        {
          "title": "Wild Horse Nine",
          "year": 2026,
          "note": "Martin McDonough; Malkovich is the lead-actor frontrunner, and McDonough a near-lock for original screenplay."
        },
        {
          "title": "Artificial",
          "year": 2026,
          "note": "Simon Rich script, Andrew Garfield a supporting lock per the Gothams; the likely smear is that it's 'not based on reality.'"
        },
        {
          "title": "Tender Loving Care",
          "year": 2026,
          "note": "Mike Leigh; Kato Flynn and Marion Bailey flagged for the acting races."
        },
        {
          "title": "Possible Love",
          "year": 2026,
          "note": "Netflix; its lead is a Best Actress contender who got recognized at the Gothams."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "10 Movies We Missed",
      "note": "with Joanna Robinson",
      "films": [
        {
          "title": "Wicker",
          "year": 2026,
          "note": "Olivia Colman commissions a woven husband, played by Alexander Skarsgard. A charming arch fable; Elizabeth Debicki steals it, and there's too much Peter Dinklage in the final act."
        },
        {
          "title": "Wildwood",
          "year": 2026,
          "note": "Laika's $100M stop-motion YA fantasy, 16 years in the making. The plot is overstuffed and it isn't for small kids, but the craft has no precedent."
        },
        {
          "title": "The Only Living Pickpocket in New York",
          "year": 2026,
          "note": "Noah Segan directs, Rian Johnson produces; Turturro in a rare restrained lead, a loose NYC character study that runs through all five boroughs."
        },
        {
          "title": "Love of Your Life",
          "year": 2026,
          "note": "Rachel Morrison; a sincere adult drama smuggled in as a Prime romance. Aaron Pierre outshines the cast, and Qualley can't quite carry it."
        },
        {
          "title": "Sacrifice",
          "year": 2026,
          "note": "Roman Gavras eat-the-rich satire; near-unanimously panned, the script is flimsy and Malkovich is barely in it."
        },
        {
          "title": "Finding Emily",
          "year": 2026,
          "note": "Alicia MacDonald rom-com; Angourie Rice plus a charming Spike Fearn. Fine, and it made them feel old."
        },
        {
          "title": "Matchbox",
          "year": 2026,
          "note": "Sam Hargrave's toy-IP action comedy with John Cena; a 'big picture evil movie' and a doom signal for Skydance."
        },
        {
          "title": "Tenzing",
          "year": 2026,
          "note": "Jennifer Peedom biopic of Tenzing Norgay; solid and beautiful, and it centers the Sherpa over Edmund Hillary (Tom Hiddleston). Speaks to the two mountain docs."
        },
        {
          "title": "The Last First: Winter K2",
          "year": 2026,
          "note": "Apple TV+ doc on the 2021 winter K2 attempts and the deaths that followed; it opens with the tragedy and asks why they did it and at whose cost."
        },
        {
          "title": "Everest: The Other Side",
          "year": 2026,
          "note": "Chin/Vasarhelyi doc; astonishing and ethically fraught, with an on-camera death and the filmmakers themselves taking part in the ambition."
        },
        {
          "title": "Clara and the Sun",
          "year": 2026,
          "note": "Taika Waititi adapting Ishiguro; the wrong filmmaker for the material, and Jenna Ortega's rough run continues. Flopping theatrically."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "Travis Knight on",
      "films": [
        {
          "title": "Wildwood",
          "year": 2026,
          "note": "16-year journey from Colin Meloy's novel; Caleb Deschanel shot it for a live-action feel, Fathom is distributing, and Knight frames it as an anti-AI 'quiet act of rebellion.'"
        },
        {
          "title": "Wild Horse Nine",
          "year": 2026,
          "note": "His last-great-thing pick, seen cold at Telluride."
        }
      ]
    }
  ],
