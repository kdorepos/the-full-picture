  "slug": "tony-and-the-top-5-coming-of-age-movies-with-matt-johnson",
  "title": "‘Tony’ and the Top 5 Coming-of-Age Movies, With Matt Johnson!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Chris Ryan"
  ],
  "published": "2026-08-21",
  "runtimeMin": 107,
  "format": "Chris Ryan joins for Matt Johnson's Anthony Bourdain movie and five coming-of-age favorites each, then Johnson turns up to explain smuggling an autobiography into a biopic.",
  "segments": [
    {
      "kind": "review",
      "heading": "‘Tony’",
      "films": [
        {
          "title": "Tony",
          "year": 2025,
          "note": "Matt Johnson's docudrama about a 19-year-old Anthony Bourdain (Dominic Sessa) taking a 1975 Cape Cod kitchen job. Antonio Banderas as the mentor chef, Leo Woodall as the line-cook cautionary tale. Co-written with Matthew Miller, Todd Bartels and Lou Howe; Bourdain's full name isn't spoken until the last scene."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "The Top 5 Coming-of-Age Movies",
      "note": "Sean and Chris, five each, counted down worst to best",
      "picks": [
        {
          "title": "My Own Private Idaho",
          "year": 1991,
          "by": "Chris Ryan",
          "note": "No. 5. Gus Van Sant reworks Henry IV and V with River Phoenix and Keanu Reeves."
        },
        {
          "title": "A Perfect World",
          "year": 1993,
          "by": "Sean Fennessey",
          "note": "No. 5. Eastwood's road movie: the escaped convict (Costner) and the boy he takes hostage, seen mostly from the kid's side."
        },
        {
          "title": "Fresh",
          "year": 1994,
          "by": "Sean Fennessey",
          "note": "No. 4. Boaz Yakin's chess-prodigy drug-runner story; Sean's favorite Samuel L. Jackson performance."
        },
        {
          "title": "Fish Tank",
          "year": 2009,
          "by": "Chris Ryan",
          "note": "No. 4. Andrea Arnold; a drifting teenage girl and her mother's boyfriend (Michael Fassbender)."
        },
        {
          "title": "Breaking Away",
          "year": 1979,
          "by": "Chris Ryan",
          "note": "No. 3. Peter Yates on Bloomington townies and a bike race; a kid faking an Italian-cyclist persona."
        },
        {
          "title": "Walkabout",
          "year": 1971,
          "by": "Sean Fennessey",
          "note": "No. 3. Nicolas Roeg strands two kids in the outback; Sean re-watched it for his Criterion Channel Odyssey curation."
        },
        {
          "title": "Hud",
          "year": 1963,
          "by": "Sean Fennessey",
          "note": "No. 2 (paired with The Last Picture Show). Larry McMurtry adaptation; his favorite Newman, James Wong Howe photography, Patricia Neal as Alma."
        },
        {
          "title": "The Last Picture Show",
          "year": 1971,
          "by": "Sean Fennessey",
          "note": "No. 2 (paired with Hud). Bogdanovich; Timothy Bottoms, Jeff Bridges, Cybill Shepherd."
        },
        {
          "title": "Rushmore",
          "year": 1998,
          "by": "Chris Ryan",
          "note": "No. 2 (paired with The Squid and the Whale). The artist as a phony young man."
        },
        {
          "title": "The Squid and the Whale",
          "year": 2005,
          "by": "Chris Ryan",
          "note": "No. 2 (paired with Rushmore). Jesse Eisenberg's would-be prodigy; Jeff Daniels and Laura Linney as the toxic parents."
        },
        {
          "title": "Stand By Me",
          "year": 1986,
          "by": "Sean Fennessey",
          "note": "No. 1. Rob Reiner from Stephen King's 'The Body.'"
        },
        {
          "title": "Juice",
          "year": 1992,
          "by": "Chris Ryan",
          "note": "No. 1. Ernest Dickerson; Omar Epps and Tupac in early-'90s Harlem."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "Matt Johnson on",
      "films": [
        {
          "title": "Nirvanna the Band the Show the Movie",
          "year": 2024,
          "note": "His prior film; screenings played like rock concerts to a fanbase he says is now out of his control."
        },
        {
          "title": "BlackBerry",
          "year": 2023,
          "note": "The model: ambition without expertise, told by an outsider to the subject."
        },
        {
          "title": "The Dirties",
          "year": 2013,
          "note": "His debut; a source of the heartsick, insecure beats he built Tony around."
        },
        {
          "title": "Pinocchio",
          "year": 1940,
          "note": "The myth he says he lifted Tony's plot from, near beat for beat."
        },
        {
          "title": "Roofman",
          "year": 2025,
          "note": "His 'last great thing': the Derek Cianfrance film he almost watched on a plane, which he says still counts."
        }
      ]
    }
