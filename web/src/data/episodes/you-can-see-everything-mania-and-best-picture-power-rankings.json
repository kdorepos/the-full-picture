{
  "slug": "you-can-see-everything-mania-and-best-picture-power-rankings",
  "title": "‘You Can See Everything’ Mania and Best Picture Power Rankings. Plus: ‘Whalefall,’ ‘Sense and Sensibility,’ and Kyle MacLachlan!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-10-20",
  "runtimeMin": 151,
  "format": "A box-office and Netflix-shakeup rundown, two new releases reviewed, the monthly Best Picture power rankings reshuffled by 'You Can See Everything,' then Kyle MacLachlan on the year he made 'Blue Velvet.'",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The News",
      "note": "box office and the Netflix shakeup",
      "films": [
        {
          "title": "Street Fighter",
          "year": 2026,
          "note": "No. 1 on its opening weekend but only $30M, a soft start the hosts barely wanted to discuss; full review coming with Shea Serrano. Sean's video-game-adaptation hopes dimmed."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "'Whalefall'",
      "films": [
        {
          "title": "Whalefall",
          "year": 2026,
          "note": "Brian Duffield directs; Austin Abrams dives for his dead father's remains and is swallowed by a whale. Sean: 50% amazing body-horror, 50% saccharine dad drama. Expensive practical sets inside the whale; soft box office. Amanda's 'Julie & Julia' problem: great in the whale, inert in the flashbacks."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "'Sense and Sensibility'",
      "films": [
        {
          "title": "Sense and Sensibility",
          "year": 2026,
          "note": "Georgia Oakley directs, Diana Reid writes; Daisy Edgar-Jones, Esme Creed-Miles, Caitriona Balfe, Frank Dillane, Herbert Nordrum, George MacKay, Fiona Shaw. A dim, Barry-Lyndon-by-candlelight, Joe-Wright-Brontëfied take that both hosts found soft-focus and underlit and miscast (Willoughby cut to nothing, no Marianne/Willoughby chemistry), Creed-Miles and Shaw excepted. Lives in the shadow of Ang Lee's 1995 version. Nixed from the Best Picture list."
        }
      ]
    },
    {
      "kind": "ranking",
      "heading": "Best Picture Power Rankings",
      "note": "monthly reshuffle, No. 1 down",
      "subject": "Best Picture",
      "ranked": true,
      "films": [
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "No. 1 - lying dormant until the Governors Awards; the top of the race feels settled."
        },
        {
          "title": "La Bola Negra",
          "year": 2026,
          "note": "No. 2 - rapturous but slow; needs acting noms (Ivan de la Fuente, Penélope Cruz) to actually win."
        },
        {
          "title": "Wild Horse 9",
          "year": 2026,
          "note": "No. 3 - Malkovich the likely winner, McDonagh in original screenplay, maybe Rockwell in supporting."
        },
        {
          "title": "You Can See Everything",
          "year": 2026,
          "note": "No. 4 - $15M on <900 screens, biggest non-music doc since 'Fahrenheit 9/11,' highest-rated on Letterboxd; toppled everyone's strategy. Only question is Academy overlap with its very young audience."
        },
        {
          "title": "Dune: Part Three",
          "year": 2026,
          "note": "No. 5 - five weeks out, no one's seen it; the 'movies are back' spectacle slot."
        },
        {
          "title": "I Play Rocky",
          "year": 2026,
          "note": "No. 6 - Bobby Farrelly crowd-pleaser, slotted over 'Michael' as the down-the-middle biopic-adjacent pick."
        },
        {
          "title": "Project Hail Mary",
          "year": 2026,
          "note": "No. 7 - not yet campaigning but will; Amazon's big sci-fi play."
        },
        {
          "title": "The Debut",
          "year": 2026,
          "note": "No. 8 - December release, Julianne Moore charm offensive."
        },
        {
          "title": "Artificial",
          "year": 2026,
          "note": "No. 9 - Neon seemingly moving chips here from 'Fjord'; Amanda kept it in just to be safe."
        },
        {
          "title": "Digger",
          "year": 2026,
          "note": "No. 10 - a sop to the vocal online hive; Tom Cruise, Iñárritu bombast."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "One Year",
      "guest": "Kyle MacLachlan on",
      "note": "the 18 months around 'Blue Velvet,' from his memoir 'Fictional Selves'",
      "films": [
        {
          "title": "Blue Velvet",
          "year": 1986,
          "note": "His second film and the one he couldn't shake; his mother, mid-chemo, struggled with the script and he nearly walked before she gave her blessing. Tested poorly, dismissed on arrival, then built a cult via Pauline Kael. He now reads it as a loss-of-innocence film."
        },
        {
          "title": "Dune",
          "year": 1984,
          "note": "His first-ever film; a contract barred other work until release so he'd arrive an unknown. Box-office disaster that left him high and dry back in a $145/month Seattle studio apartment."
        },
        {
          "title": "Platoon",
          "year": 1986,
          "note": "A non-Dune option picture at De Laurentiis; Oliver Stone wanted him for Chris. He hesitated over the ending and the role went to Charlie Sheen."
        },
        {
          "title": "Top Gun",
          "year": 1986,
          "note": "He read for Goose, not the Cruise role; doubts Tony Scott would have had him."
        },
        {
          "title": "sex, lies, and videotape",
          "year": 1989,
          "note": "Soderbergh wanted him, or at least strongly considered him; he removed himself on advice against another sexually-hung-up part. They're friends now."
        },
        {
          "title": "The Hidden",
          "year": 1987,
          "note": "His third film and first without Lynch; sci-fi cop-buddy horror with Michael Nouri, a now-cult object he stepped out on his own in, cribbing Mel Gibson's cartridge-eject bit."
        },
        {
          "title": "Zulu",
          "year": 1964,
          "note": "His 'last great thing,' caught on a plane; 'introducing Michael Caine,' whom he watched get better in real time."
        }
      ]
    }
  ],
