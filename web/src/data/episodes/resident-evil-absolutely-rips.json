  ],
  "published": "2026-09-17",
  "runtimeMin": 100,
  "format": "Movie news, then Sean Fennessey and Chris Ryan rave through Zach Cregger's ‘Resident Evil,’ capped by a short history of horror comedy.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The Movie News",
      "films": [
        {
          "title": "Jay Kelly",
          "year": 2025,
          "note": "Baumbach's latest; part of why he's leaving Netflix for Warner's Clockwork imprint."
        },
        {
          "title": "White Noise",
          "year": 2022,
          "note": "The other recent Baumbach that landed softly; Sean's a defender."
        },
        {
          "title": "The Meyerowitz Stories (New and Selected)",
          "year": 2017,
          "note": "Early, well-liked Baumbach-for-Netflix."
        },
        {
          "title": "Marriage Story",
          "year": 2019,
          "note": "The celebrated one."
        },
        {
          "title": "The Devils",
          "year": 1971,
          "note": "Ken Russell; Clockwork made its name restoring it, back in theaters in October."
        },
        {
          "title": "Nasty",
          "note": "Mary Bronstein's follow-up to 'If I Had Legs, I'd Kick You,' at Clockwork; Rose Byrne and Jenna Ortega, produced by Margot Robbie's LuckyChap."
        },
        {
          "title": "Tiamo",
          "note": "Sean Baker's Anora follow-up, at Clockwork."
        },
        {
          "title": "Anora",
          "year": 2024,
          "note": "The Baker film Tiamo follows."
        },
        {
          "title": "The Brigands of Rattle Creek",
          "note": "Park Chan-wook's first English film since Stoker; Zahler script; Butler, McConaughey, Pascal, Adele Exarchopoulos, Tang Wei."
        },
        {
          "title": "Stoker",
          "year": 2013,
          "note": "Park's last English-language film before this."
        },
        {
          "title": "The Rip",
          "year": 2026,
          "note": "Cited as the new Netflix mode: programmers over prestige."
        },
        {
          "title": "Once Upon a Time in Hollywood",
          "year": 2019,
          "note": "The Cliff Booth movie continues its story eight years on."
        },
        {
          "title": "The Further Misadventures of Cliff Booth",
          "year": 2025,
          "note": "Fincher/Pitt, set 1977; IMAX at Thanksgiving, still essentially no trailer two months out."
        },
        {
          "title": "Barbie",
          "year": 2023,
          "note": "Baumbach and Gerwig reportedly negotiating a sequel with Warner even as he joins Clockwork."
        },
        {
          "title": "Obsession",
          "note": "Last year's TIFF Midnight Madness sensation, bought by Blumhouse for $15M."
        },
        {
          "title": "River",
          "note": "New Blumhouse TIFF pickup ($10M), a shutter film reworked; Jane Levy and Jessica Rothe as siblings stalked on a boat."
        },
        {
          "title": "Miami Vice 85",
          "note": "Joseph Kosinski, Dan Gilroy script; John Leguizamo (likely Calderon) and Alden Ehrenreich cast."
        },
        {
          "title": "Lone Survivor",
          "year": 2013,
          "note": "Cited for Peter Berg's vision ahead of his Call of Duty movie."
        },
        {
          "title": "Atomic Blonde",
          "year": 2017,
          "note": "A midnight-madness-delirium casualty from their festival days."
        },
        {
          "title": "Long Shot",
          "year": 2019,
          "note": "Same category of late-night screening overrating."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Resident Evil’ Absolutely Rips!",
      "note": "spoilers throughout",
      "films": [
        {
          "title": "Resident Evil",
          "year": 2026,
          "note": "Zach Cregger's third feature, co-written by Shay Hatton; Austin Abrams as a medical courier surviving a Raccoon City outbreak. 87 minutes, gory and funny, breaks every studio rule (kills the dog, the kid, the babies). Both hosts have it in their films of the year."
        },
        {
          "title": "Resident Evil",
          "year": 2002,
          "note": "Paul W.S. Anderson/Milla Jovovich original; first of six films that grossed over $1B."
        },
        {
          "title": "Resident Evil: Welcome to Raccoon City",
          "year": 2021,
          "note": "Johannes Roberts reboot that flopped, released mid-pandemic; more faithful to the games than Cregger's."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "A Short History of Horror Comedy",
      "films": [
        {
          "title": "Gremlins",
          "year": 1984,
          "note": "Gateway horror for their generation."
        },
        {
          "title": "The Monster Squad",
          "year": 1987
        },
        {
          "title": "Ghostbusters",
          "year": 1984,
          "note": "Horror-for-kids that adults love for Venkman."
        },
        {
          "title": "Shaun of the Dead",
          "year": 2004,
          "note": "On the very short list of gore-and-comedy that actually works."
        },
        {
          "title": "Fright Night",
          "year": 1985,
          "note": "Also on that short list; Sean flags the 2011 Anton Yelchin/Colin Farrell remake as more serious but still funny."
        },
        {
          "title": "An American Werewolf in London",
          "year": 1981
        },
        {
          "title": "The Cabin in the Woods",
          "year": 2012,
          "note": "Clever and amusing, but did it make him laugh?"
        },
        {
          "title": "The Texas Chainsaw Massacre 2",
          "year": 1986,
          "note": "Funny and effective, a great zag from the original, but not a great horror comedy per Sean."
        },
        {
          "title": "The Return of the Living Dead",
          "year": 1985
        },
        {
          "title": "Creepshow",
          "year": 1982
        },
        {
          "title": "Lake Placid",
          "year": 1999,
          "note": "Written comically scene to scene with real gore."
        },
        {
          "title": "Abbott and Costello Meet Frankenstein",
          "year": 1948,
          "note": "Testing whether it still plays for a kid today."
        },
        {
          "title": "Frankenstein",
          "year": 1931,
          "note": "No longer scary to little kids."
        },
        {
          "title": "Young Frankenstein",
          "year": 1974,
          "note": "And no longer reliably funny either, comic sensibilities shift."
        },
        {
          "title": "Little Shop of Horrors",
          "year": 1986,
          "note": "Kind of funny, kind of horror; scared Sean in third grade."
        },
        {
          "title": "Scream",
          "year": 1996,
          "note": "Kennedy and Lillard actually make him laugh."
        },
        {
          "title": "Scream 2",
          "year": 1997,
          "note": "More jokey, leaning into laugh lines, not as funny as the first."
        },
        {
          "title": "The Evil Dead",
          "year": 1981,
          "note": "Landmark."
        },
        {
          "title": "Evil Dead II",
          "year": 1987,
          "note": "A masterpiece; the register Cregger cites."
        },
        {
          "title": "Army of Darkness",
          "year": 1992,
          "note": "Awesome."
        },
        {
          "title": "Evil Dead Rise",
          "year": 2023,
          "note": "Liked it enough."
        },
        {
          "title": "Evil Dead Burn",
          "year": 2026,
          "note": "A real drag; good individual kills, tone way off, exactly the ponderous seriousness they're tired of."
        },
        {
          "title": "Casablanca",
          "year": 1942,
          "note": "Invoked for how foundational and ripped-off the Evil Dead films now are."
        }
      ]
    }
