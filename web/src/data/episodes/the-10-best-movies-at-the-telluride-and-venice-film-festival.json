{
  "slug": "the-10-best-movies-at-the-telluride-and-venice-film-festival",
  "title": "The 10 Best Movies at the Telluride and Venice Film Festivals. Plus: Nathan Fielder’s Stunning Elizabeth Holmes Doc.",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-09-08",
  "runtimeMin": 111,
  "format": "Sean back from Telluride, Amanda still in Venice: dueling five-best lists from the fall festivals, plus the Nathan Fielder Elizabeth Holmes doc that took over Telluride.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "Movie news: the first look at 'Artificial'",
      "films": [
        {
          "title": "Artificial",
          "year": 2026,
          "note": "Neon; Luca Guadagnino on Sam Altman and OpenAI, with Andrew Garfield, Yura Borisov, Ike Barinholtz as Musk, Monica Barbaro. New teaser leans hard on the Social Network homage; NYFF in a month, wide in early 2027."
        },
        {
          "title": "The Social Network",
          "year": 2010,
          "note": "The film the Artificial teaser openly echoes, Eisenberg walking through Harvard Square. 'One of my favorite films of my lifetime.'"
        }
      ]
    },
    {
      "kind": "review",
      "heading": "The Telluride secret screening: Nathan Fielder's Elizabeth Holmes doc",
      "note": "Sean's No. 1",
      "films": [
        {
          "title": "You Can See Everything",
          "year": 2026,
          "note": "The true-TBA that dominated every line. Fielder and Lance Oppenheim's 3-hour Holmes doc; phones bagged, Emma Stone moderating. Starts as a rehearsal-style portrait before her prison term, then breaks form entirely. 'Fucking amazing.' Out October."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Sean's 5 best at Telluride",
      "subject": "Telluride",
      "ranked": true,
      "films": [
        {
          "title": "You Can See Everything",
          "year": 2026,
          "note": "No. 1. The secret-screening doc; detonates the authorized-portrait and true-crime modes at once. He wrote about it on Projections."
        },
        {
          "title": "Wild Horse Nine",
          "year": 2026,
          "note": "No. 2. Martin McDonagh's 'The American in In Bruges'; Malkovich and Rockwell as CIA men in 1970s Chile. Malkovich the presumptive Oscar lock."
        },
        {
          "title": "The Debut",
          "year": 2026,
          "note": "No. 3. Jesse Eisenberg's third feature; Julianne Moore and Paul Giamatti in community theater, a near-standing-ovation mid-scene for Moore."
        },
        {
          "title": "Tender Loving Care",
          "year": 2026,
          "note": "No. 4. Reportedly Mike Leigh's last film; Kate O'Flynn and Marion Bailey. Very sad, a callback to his '70s-'80s work. Out December."
        },
        {
          "title": "Ink",
          "year": 2026,
          "note": "Tied at No. 5. Danny Boyle on Larry Lamb and Rupert Murdoch (Jack O'Connell, Guy Pearce, Claire Foy). Engaging, cranked hard, doesn't land the plane; flagged for noticeable generative-AI inserts."
        },
        {
          "title": "Everest: The Other Side",
          "year": 2026,
          "note": "Tied at No. 5. Vasarhelyi and Chin's Nat Geo doc on climber Jim Morrison scaling Everest's North Face. Astonishing, wept three times, unsure it should exist."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Amanda's 5 best at Venice",
      "subject": "Venice",
      "ranked": true,
      "films": [
        {
          "title": "Wild Horse Nine",
          "year": 2026,
          "note": "No. 1. Premiered at Venice; the reveal drops it squarely in her comfort zone. Malkovich gives an incredible performance."
        },
        {
          "title": "Prime Time",
          "year": 2026,
          "note": "No. 2. Lance Oppenheim's To Catch a Predator narrative feature; Robert Pattinson, Skyler Gisondo, Merritt Wever, Phoebe Bridgers. Pattinson 'so out there in the best way.' Out September 25."
        },
        {
          "title": "Possible Love",
          "year": 2026,
          "note": "No. 3. Lee Chang-dong's first since Burning; South Korea's Oscar entry, loosely drawn from a Dekalog episode. Empirically excellent, but has 'the whiteboard problem.'"
        },
        {
          "title": "Everest: The Other Side",
          "year": 2026,
          "note": "Tied at No. 4. Wept three times; got angry at everyone in it, including her husband by transitive property."
        },
        {
          "title": "Oasis: Don't Look Back in Anger",
          "year": 2026,
          "note": "Tied at No. 4. Southern and Lovelace's reunion-tour doc; Liam and Noel holding hands. Cried singing along at 8:45 a.m."
        },
        {
          "title": "Ink",
          "year": 2026,
          "note": "No. 5. Same slot as Sean's; good, not great Danny Boyle."
        }
      ]
    },
    {
      "kind": "list",
      "heading": "Honorable mentions",
      "note": "seen around the fests",
      "picks": [
        {
          "title": "The Liberation",
          "year": 2026,
          "by": "Sean",
          "note": "Guy Nattiv; Carrie Coon joins a cult, with Tracy Letts, Bella Ramsey, Odessa Young, Lily James as the leader. Liked, not loved: it withholds how the cult started."
        },
        {
          "title": "Bucking Fastard",
          "year": 2026,
          "by": "Both",
          "note": "Werner Herzog, dedicated to David Lynch; Rooney and Kate Mara as sisters. One forklift scene called triumphant."
        },
        {
          "title": "Elsinore",
          "year": 2026,
          "by": "Sean",
          "note": "Simon Stone; Andrew Scott as Ian Charleson performing Hamlet through AIDS. Film weak, performance extraordinary, a lone-nomination candidate."
        },
        {
          "title": "Three Colors: Blue",
          "year": 1993,
          "by": "Amanda",
          "note": "Kieslowski, seen at a Venice Letterboxd rooftop event; Golden Lion winner, tied to Possible Love's Dekalog roots."
        },
        {
          "title": "The Disciple",
          "year": 2026,
          "by": "Sean",
          "note": "Netflix doc on Wu-Tang affiliate Silver Rings and Once Upon a Time in Shaolin. Missed the listening party: sick, fell asleep."
        },
        {
          "title": "Musk",
          "year": 2026,
          "by": "Amanda",
          "note": "Alex Gibney's 4-hour doc; comprehensive and damning, but a junky CGI Musk avatar narrates over video-game structure she hated."
        }
      ]
    }
