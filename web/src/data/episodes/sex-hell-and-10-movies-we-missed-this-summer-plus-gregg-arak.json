{
  "slug": "sex-hell-and-10-movies-we-missed-this-summer-plus-gregg-arak",
  "title": "Sex, Hell, and 10 Movies We Missed This Summer. Plus: Gregg Araki!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-07-28",
  "runtimeMin": 144,
  "format": "Sean and Amanda catch up on two months of releases they missed, score their summer box-office prediction game, and Gregg Araki stops by for his first feature in 12 years.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "Comic-Con and the News",
      "note": "Gosling, a new Black Panther, and Nolan's Odyssey",
      "films": [
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "$640M in eight and a half days, a 29% second-weekend drop, headed for maybe 1.3-1.5B. Emily Wilson's takedown ran in the London Review of Books."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "Summer Movie Preview Game: The Check-In",
      "note": "the box-office scorecard, two months later",
      "films": [
        {
          "title": "Backrooms",
          "year": 2026,
          "note": "One of the worst guesses: both lowballed it, film made $197M."
        },
        {
          "title": "Obsession",
          "year": 2026,
          "note": "Sean guessed $42M; it landed near $400M."
        },
        {
          "title": "Disclosure Day",
          "year": 2026,
          "note": "Sean guessed $121M, sitting at $116M and still in theaters."
        },
        {
          "title": "Supergirl",
          "year": 2026,
          "note": "One of the lowest-grossing DC movies ever at $71M; the world did not care."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "10 Movies We Missed This Summer",
      "note": "seen late, reviewed here",
      "films": [
        {
          "title": "Moana",
          "year": 2026,
          "note": "Live-action remake, dir. Thomas Kail. Sean: DOA, CGI hell, no case for being 30-45 minutes longer than the 91-minute original."
        },
        {
          "title": "Minions and Monsters",
          "year": 2026,
          "note": "Seventh Minions feature, 1920s Hollywood, dir. Pierre Coffin. Amanda charmed (Babylon with minions); Sean bored. Underperformed at $149M."
        },
        {
          "title": "The Dink",
          "year": 2026,
          "note": "Apple pickleball comedy, dir. Josh Greenbaum, Jake Johnson. Uneven, but the Mary Steenburgen dynamic and Andy Roddick cameo land."
        },
        {
          "title": "Gail Daughtry and the Celebrity Sex Pass",
          "year": 2026,
          "note": "David Wain, Zoey Deutch, Jon Hamm. A Wizard of Oz road movie about a sex pass; funnier in theory than in the seats."
        },
        {
          "title": "Evil Dead Burn",
          "year": 2026,
          "note": "Sixth Evil Dead, dir. Sebastien Vanicek (Infested). Meaner and grimmer than the series needs. Not recommend."
        },
        {
          "title": "I Want Your Sex",
          "year": 2026,
          "note": "Araki's return. Olivia Wilde as a domineering gallerist, Cooper Hoffman as her sub. Wilde is the reason to go."
        },
        {
          "title": "Her Private Hell",
          "year": 2026,
          "note": "Refn's first feature in a decade. Beautifully designed, turgidly paced; Amanda forgot she'd even seen it at Cannes."
        },
        {
          "title": "Young Washington",
          "year": 2026,
          "note": "Angel Studios, French and Indian War, William Franklin-Miller as young George. Dad-history vibe, boring; already a hit."
        },
        {
          "title": "Motor City",
          "year": 2026,
          "note": "Nearly dialogue-free Detroit revenge picture, dir. Potsy Ponciroli, Alan Richson. Formally bold, doesn't fully cohere; Fleetwood Mac needle drop."
        },
        {
          "title": "Voicemails for Isabel",
          "year": 2026,
          "note": "Netflix rom-com, Zoey Deutch, Nick Robinson. Grief-then-wrong-number premise you see coming; dessert-nacho food truck and all. Not bad."
        },
        {
          "title": "The Samurai and the Prisoner",
          "year": 2026,
          "note": "Kiyoshi Kurosawa, 16th-century Japan: Columbo in a besieged castle, with a hard third-act turn. Worth the time."
        },
        {
          "title": "Sheep in the Box",
          "year": 2026,
          "note": "Grief-and-AI-android drama, Neon. Sean: pretty much a fiasco."
        },
        {
          "title": "Late Fame",
          "year": 2026,
          "note": "Kent Jones, from a Schnitzler novella adapted by Sammy Burch. Willem Dafoe as a post-office worker rediscovered as a poet; Jake Lacey's agent scene is great."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "Gregg Araki on",
      "films": [
        {
          "title": "I Want Your Sex",
          "year": 2026,
          "note": "Split himself into Wilde's Erica Tracy and Hoffman's intern; swapped the sub/dom roles to a female top around 2016-17."
        },
        {
          "title": "Nowhere",
          "year": 1997,
          "note": "Teen Apocalypse trilogy; originally developed as a TV pilot. Remastered."
        },
        {
          "title": "Kaboom",
          "year": 2010,
          "note": "The A-team of crew and cast he carried into his Starz show."
        },
        {
          "title": "The Doom Generation",
          "year": 1995,
          "note": "The one fans carry for decades; Margaret Cho's eye-slash quotes Potemkin. Remastered."
        },
        {
          "title": "Mysterious Skin",
          "year": 2004,
          "note": "Re-released August; remaster finished last year."
        },
        {
          "title": "Smiley Face",
          "year": 2007,
          "note": "Rewatched alongside Doom the night before; his intimate, close-in camera on display."
        }
      ]
    }
  ],
