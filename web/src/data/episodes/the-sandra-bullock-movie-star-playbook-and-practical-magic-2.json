{
  "slug": "the-sandra-bullock-movie-star-playbook-and-practical-magic-2",
  "title": "The Sandra Bullock Movie Star Playbook and ‘Practical Magic 2.’ Plus: ‘Oasis: Don’t Look Back in Anger.’",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins",
    "Yasi Salek"
  ],
  "published": "2026-09-15",
  "runtimeMin": 95,
  "format": "Reports from TIFF and Venice, the Oasis reunion doc, why the ‘Practical Magic’ sequel underperformed, and a plan for Sandra Bullock's filmography.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "Festival dispatch",
      "note": "TIFF and Venice, from afar",
      "films": [
        {
          "title": "I Play Rocky",
          "year": 2025,
          "note": "TIFF biopic about the making of ‘Rocky.’ Sean expected to hate it, didn't."
        },
        {
          "title": "Your Mother",
          "year": 2025,
          "note": "Mahershala Ali and Bassam Tariq's film, made after the ‘Blade’ they never got to make. Sean: really good."
        },
        {
          "title": "Woman Unknown",
          "year": 2025,
          "note": "Venice Golden Lion winner. Set in post-war 1945 Denmark and told from the women's side. Competent but forgettable, and it lifts a beat or two from ‘Game of Thrones.’ The premiere ran with botched subtitles."
        },
        {
          "title": "Possible Love",
          "year": 2025,
          "note": "Presumed favorite; took the Silver Lion instead."
        },
        {
          "title": "Wild Horse Nine",
          "year": 2025,
          "note": "Malkovich won for it, unsurprisingly."
        },
        {
          "title": "Naza",
          "year": 2025,
          "note": "Special jury prize, from Yuval Abraham and Rachel Szor."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Oasis: Don't Look Back in Anger’",
      "note": "the Millennial ultratext",
      "films": [
        {
          "title": "Oasis: Don't Look Back in Anger",
          "year": 2025,
          "note": "Will Lovelace and Dylan Southern's concert doc on the reunion tour. Twins the Noel/Liam thaw with the fans' relationship to the songs, one city per track. Restrained where it could be maudlin (the autistic kid and ‘Talk Tonight,’ the dog named Bonehead). Yasi's five out of five."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘Practical Magic 2’",
      "note": "the 90s, reheated",
      "films": [
        {
          "title": "Practical Magic 2",
          "year": 2025,
          "note": "Suzanne Bier directs. Kidman and Bullock return; Joey King and Maisie Williams as Sally's daughters (playing 20 years younger than their age, which nobody explains), Lee Pace wasted on half a hip shimmy. Wooden dialogue, Vaseline-lens photography, CGI third act, heavy product placement. Underperformed at $30M against ~$46M tracking. Yasi came in loving the first one and left crushed."
        },
        {
          "title": "Practical Magic",
          "year": 1998,
          "note": "Griffin Dunne's original. A box-office miss turned fall-season comfort watch; the curse reads as a metaphor for risking love. Sean had never seen it until this week."
        }
      ]
    },
    {
