{
  "slug": "the-end-of-oak-street-and-the-top-five-twilight-zone-movies-",
  "title": "‘The End of Oak Street’ and the Top Five 'Twilight Zone' Movies. Plus: Will Poulter!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Chris Ryan",
    "Mallory Rubin"
  ],
  "published": "2026-08-18",
  "runtimeMin": 153,
  "format": "A dinosaur-thriller review, a Twilight Zone top five from all three chairs, and Will Poulter on 'Union County,' after a long D23 detour.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The Movie News",
      "note": "X-Men casting, trailers, and the D23 slate",
      "films": [
        {
          "title": "X-Men",
          "year": 2028,
          "note": "Jake Schreier directing; Christopher Abbott as Xavier, Adam Driver as Mr. Sinister, Kit Connor and Sadie Sink leading a deliberately Gen-Z cast. No Wolverine or Magneto announced."
        },
        {
          "title": "Avengers: Doomsday",
          "year": 2026,
          "note": "Second trailer read as a market improvement, dramatic stakes at last, but still shot in front of a giant green screen. Downey's Latverian accent the highlight."
        },
        {
          "title": "Star Wars: Starfighter",
          "year": 2027,
          "note": "Teaser framed around the ship, not the cast. Gosling plays Cade Oberon; set five years after the First Order."
        },
        {
          "title": "Gato",
          "year": 2027,
          "note": "Pixar mafia-cat movie set in Venice; hand-painted look drew the biggest response of the night."
        },
        {
          "title": "Incredibles 3",
          "note": "Peter Sohn directing, not Brad Bird."
        },
        {
          "title": "Coco 2",
          "year": 2029
        },
        {
          "title": "Frozen 3",
          "year": 2027
        },
        {
          "title": "The Bluey Movie",
          "year": 2027,
          "note": "Slightly heightened animation style; an easy $500M given how encoded the show is for parents."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "The Last House",
      "note": "the Netflix warm-up nobody remembers",
      "films": [
        {
          "title": "The Last House",
          "year": 2026,
          "note": "Louis Leterrier's No. 1 Netflix movie: a family sealed inside their home by sentient rain that turns out to be a Lovecraftian monster picture. Greta Lee and Wagner Moura cashing in; a literalization of Bowfinger's 'Chubby Rain.'"
        }
      ]
    },
    {
      "kind": "review",
      "heading": "The End of Oak Street",
      "films": [
        {
          "title": "The End of Oak Street",
          "year": 2026,
          "note": "David Robert Mitchell's 92-minute Amblin-by-way-of-Twilight-Zone dinosaur movie. A wormhole drops a suburban block into prehistory. Anne Hathaway great, Ewan McGregor the weak link (and killed two-thirds in). Mean kills, a portal-reset ending that spawns two Jeanettes."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Mallory's Top Five 'Twilight Zone' Movies",
      "subject": "Twilight Zone movies",
      "ranked": true,
      "films": [
        {
          "title": "The Truman Show",
          "year": 1998,
          "note": "No. 1. Met the prompt and became its own reference point; had her checking for cameras for years."
        },
        {
          "title": "Moon",
          "year": 2009,
          "note": "Sam Rockwell and a twist about confronting another version of yourself."
        },
        {
          "title": "Arrival",
          "year": 2016,
          "note": "Perception of time as the real reveal; among the best films of the century."
        },
        {
          "title": "Get Out",
          "year": 2017,
          "note": "The sunken place; Peele's most overtly Twilight Zone film."
        },
        {
          "title": "Groundhog Day",
          "year": 1993,
          "note": "Slotted at five only because Sean already had it."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Chris's Top Five 'Twilight Zone' Movies",
      "subject": "Twilight Zone movies",
      "ranked": true,
      "films": [
        {
          "title": "The Game",
          "year": 1997,
          "note": "No. 1. Fincher's how-fucked-up-are-yuppies birthday nightmare."
        },
        {
          "title": "Shutter Island",
          "year": 2010,
          "note": "One of the great twists; truly one of the saddest movies of the 2010s."
        },
        {
          "title": "The Swimmer",
          "year": 1968,
          "note": "Frank Perry's Cheever adaptation; sat at No. 1 until the last second."
        },
        {
          "title": "Field of Dreams",
          "year": 1989,
          "note": "Shared favorite with Mallory; a cornfield voice as a clean Twilight Zone premise."
        },
        {
          "title": "It Ends",
          "year": 2024,
          "note": "Alexander Allen's never-ending road-trip time loop."
        }
      ]
    },
    {
      "kind": "topfive",
      "heading": "Sean's Top Five 'Twilight Zone' Movies",
      "subject": "Twilight Zone movies",
      "ranked": true,
      "films": [
        {
          "title": "Seconds",
          "year": 1966,
          "note": "No. 1. Frankenheimer's new-body-new-life horror; Shutter Island before Shutter Island."
        },
        {
          "title": "Groundhog Day",
          "year": 1993,
          "note": "The comic entry, watched 700 times as a kid."
        },
        {
          "title": "The Quiet Earth",
          "year": 1985,
          "note": "New Zealand last-man-alive picture."
        },
        {
          "title": "Repeat Performance",
          "year": 1947,
          "note": "A pre-Twilight-Zone noir time loop that plays shockingly modern."
        },
        {
          "title": "The Vast of Night",
          "year": 2019,
          "note": "Andrew Patterson's modestly budgeted radio-signal wonder."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "Will Poulter on",
      "films": [
        {
          "title": "Union County",
          "year": 2026,
          "note": "Adam Meeks's debut docufiction, made with an Ohio drug-court recovery community and its real director, Annette Dio. Poulter plays the withdrawn Cody opposite Noah Centineo's gregarious Jack."
        },
        {
          "title": "Hook",
          "year": 1991,
          "note": "His favorite film of all time; wanted to be a Lost Boy."
        },
        {
          "title": "Son of Rambow",
          "year": 2007,
          "note": "His first film, shot on a school summer holiday."
        },
        {
          "title": "The Chronicles of Narnia: The Voyage of the Dawn Treader",
          "year": 2010,
          "note": "His mother and sister came along; his father took a sabbatical."
        },
        {
          "title": "Warfare",
          "year": 2025,
          "note": "Where he and Centineo bonded, 17-hour days across two months, before Union County."
        },
        {
          "title": "One Battle After Another",
          "year": 2025,
          "note": "Cited PTA and DiCaprio on how many non-professional actors changed the energy."
        },
        {
          "title": "Omaha",
          "year": 2025,
          "note": "Cole Webley's film; a devastating recent watch, John Magaro strong."
        },
        {
          "title": "Come See Me in the Good Light",
          "year": 2025,
          "note": "Oscar-nominated documentary; his other 'last great thing.'"
        }
      ]
    }
  ],
