      "films": [
        {
          "title": "Teenage Sex and Death at Camp Miasma",
          "year": 2026,
          "note": "Jane Schoenbrunn's third feature: a queer director obsessed with casting the original final girl of the slasher franchise she's rebooting. Hannah Einbinder as Chris, Gillian Anderson as Billie. Candy-coated where TV Glow was melancholy; a Counting Crows needle drop scores the mid-film POV kill."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The Final Girl Film Canon",
      "note": "Carol Clover's trope, tracked across the decades",
      "films": [
