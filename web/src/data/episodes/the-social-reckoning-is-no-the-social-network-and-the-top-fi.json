{
  "slug": "the-social-reckoning-is-no-the-social-network-and-the-top-fi",
  "title": "‘The Social Reckoning’ Is No ‘The Social Network,’ and the Top Five Most Unnecessary Legasequels. Plus: The Best Movies at NYFF!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-10-09",
  "runtimeMin": 111,
  "format": "The Big Picture After Dark: Skydance's franchise slate, Sean's New York Film Festival dispatch, Aaron Sorkin's doomed 'Social Network' follow-up, and a loose survey of the best and worst legacy sequels.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The Skydance Era Movie News",
      "note": "every franchise coming back",
      "films": [
        {
          "title": "Transformers",
          "year": 2007,
          "note": "Franchise rebooting again with Spielberg producing; Sean's seen the first and 'Dark of the Moon.'"
        },
        {
          "title": "Bumblebee",
          "year": 2018,
          "note": "The last attempt to relaunch; Amanda liked the Hailee Steinfeld trailer."
        },
        {
          "title": "Transformers: Rise of the Beasts",
          "year": 2023,
          "note": "Steven Caple Jr. (Creed II); Sean liked it, nobody else did."
        },
        {
          "title": "Transformers: Dark of the Moon",
          "year": 2011,
          "note": "The one Amanda half-remembered; they jokingly dubbed it 'the JFK one.'"
        },
        {
          "title": "A Quiet Place",
          "year": 2018
        },
        {
          "title": "A Quiet Place Part II",
          "year": 2020,
          "note": "Amanda soured on the silly final shot."
        },
        {
          "title": "A Quiet Place: Day One",
          "year": 2024,
          "note": "The third film; nobody locked up the fentanyl. 'A Quiet Place 3' lands on Sean's reunion weekend."
        },
        {
          "title": "The Godfather",
          "year": 1972,
          "note": "Sean's recurring bit: a demon at Skydance would greenlight 'Godfather IV' while Pacino's still breathing."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The Best Movies at the New York Film Festival",
      "note": "Sean's dispatch from Lincoln Center",
      "films": [
        {
          "title": "Artificial",
          "year": 2025,
          "note": "Luca Guadagnino's OpenAI movie; Amazon dropped it, Neon picked it up. Both rave: a Best Picture-level jolt and maybe Andrew Garfield's best work. Damon Albarn scored it and played piano before the premiere."
        },
        {
          "title": "Behemoth",
          "year": 2025,
          "note": "Tony Gilroy's post-'Andor' film, out Dec 4. Not 'Michael Clayton 2'; a subtle, passive-protagonist piece with the best Pedro Pascal performance, built around a cellist and nine film composers."
        },
        {
          "title": "Naza",
          "note": "Investigative doc on IDF strikes in Gaza from the 'No Other Land' team (Yuval Abraham, Rachel Szor), exec-produced by Jonathan Glazer; The Guardian helping release it. Title as transcribed, likely a mishear."
        },
        {
          "title": "Cameron Winter at Carnegie Hall",
          "year": 2025,
          "note": "PTA concert film (Benny Safdie on camera). A diagrammatic tour of where you can put a camera in the hall; speaks to Winter fans more than newcomers."
        },
        {
          "title": "A Statement",
          "year": 2025,
          "note": "Tom McCarthy's people-talking-in-rooms drama from Nathaniel Rich's 'Losing Earth'; a 1980 St. Petersburg climate panel, dialogue pulled from the transcript. Giamatti, Turturro, Rudd, Ryan. SPC, awards-qualifying toward a 2027 release."
        },
        {
          "title": "Making Marie Antoinette",
          "year": 2025,
          "note": "Eleanor Coppola's behind-the-scenes doc of Sofia's 2006 film, finished after Coppola's death; narration from her journals read by Diane Lane. A portrait of a mother watching her daughter direct."
        },
        {
          "title": "Godzilla Minus Zero",
          "year": 2025,
          "note": "Sequel to 'Godzilla Minus One,' a Ghidorah origin. Sean loved the monster choreography; a touch too much WWII human struggle padding out the second half."
        },
        {
          "title": "Joy of Joys",
          "year": 2025,
          "note": "35-min Jonathan Glazer doc on a war-zone benefit album (Jarvis Cocker, Fontaines D.C., Albarn, Olivia Rodrigo) filmed by eight-year-olds. Sweet, worth the time."
        },
        {
          "title": "Musk",
          "year": 2025,
          "note": "Alex Gibney's four-hour doc. Comprehensive and convincing but little new; irritating video-game framing and a glowed-up CGI avatar. Never explains what's underneath him."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "‘The Social Reckoning’",
      "note": "Aaron Sorkin writes and directs the ‘Social Network’ sequel",
      "films": [
        {
          "title": "The Social Reckoning",
          "year": 2025,
          "note": "Sorkin's Frances Haugen whistleblower movie (Mikey Madison, Jeremy Allen White, Jeremy Strong as Zuckerberg). A network TV procedural that mistakes disclosure for revelation; the Strong/Burr prep-room scenes work, little else does. Both agree it doesn't justify existing. Fincher-plus-Eisenberg would help; it still wouldn't need to."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The Most Unnecessary Legasequels",
      "note": "best and worst, freewheeling — no actual ranked five revealed on air",
      "films": [
        {
          "title": "Top Gun: Maverick",
          "year": 2022,
          "note": "Sean's favorite legacy sequel, full stop."
        },
        {
          "title": "Mad Max: Fury Road",
          "year": 2015,
          "note": "Possibly the greatest of all time."
        },
        {
          "title": "Scream",
          "year": 2022,
          "note": "The Melissa Barrera / Jenna Ortega relaunch; pretty good, lands ~10 years after 'Scream 4.'"
        },
        {
          "title": "Halloween",
          "year": 2018,
          "note": "First David Gordon Green entry; Sean enjoyed it, saw it in theaters."
        },
        {
          "title": "The First Omen",
          "year": 2024,
          "note": "Works precisely because it doesn't try to be 'The Omen.' Nun impregnated by satanic cultists."
        },
        {
          "title": "The Matrix Resurrections",
          "year": 2021,
          "note": "Sean likes the disliked COVID/Project Popcorn entry."
        },
        {
          "title": "Jurassic World",
          "year": 2015,
          "note": "Enjoyable as a horror movie; everything after is a car crash."
        },
        {
          "title": "Jurassic World Rebirth",
          "year": 2025,
          "note": "Shot on film, brontosaurus in Cobble Hill, Jonathan Bailey. Sean: a piece of shit."
        },
        {
          "title": "Indiana Jones and the Dial of Destiny",
          "year": 2023,
          "note": "'The Archimedes one'; Sean has more time for it than 'Crystal Skull.'"
        },
        {
          "title": "Evil Dead Rise",
          "year": 2023,
          "note": "Sean kind of enjoyed it."
        },
        {
          "title": "The Accountant 2",
          "year": 2025,
          "note": "Jack's favorite Affleck movie; a room full of coding children. Sean's 'new Salt.'"
        },
        {
          "title": "The Devil Wears Prada 2",
          "year": 2026,
          "note": "Amanda had a nice time, laughed a little. 'How were things at Coach?'"
        },
        {
          "title": "Borat Subsequent Moviefilm",
          "year": 2020,
          "note": "Both didn't mind it; Maria Bakalova and the Giuliani bit."
        },
        {
          "title": "Halloween H20: 20 Years Later",
          "year": 1998,
          "note": "Amanda loves it; Sean calls it overrated."
        },
        {
          "title": "Zoolander 2",
          "year": 2016,
          "note": "Bad."
        },
        {
          "title": "Doctor Sleep",
          "year": 2019,
          "note": "Not for Sean, though Gilbert Cruz has real affection; Rebecca Ferguson's Rose the Hat."
        },
        {
          "title": "The Strangers",
          "year": 2008,
          "note": "The good original."
        },
        {
          "title": "The Strangers: Chapter 1",
          "year": 2024,
          "note": "Three prequels that reveal who the strangers are, defeating the point. Really bad."
        },
        {
          "title": "Coming 2 America",
          "year": 2021,
          "note": "Bad."
        },
        {
          "title": "Indiana Jones and the Kingdom of the Crystal Skull",
          "year": 2008,
          "note": "Doesn't work at all."
        },
        {
          "title": "Evil Dead",
          "year": 2013,
          "note": "Sean doesn't like the reboot."
        },
        {
          "title": "Candyman",
          "year": 2021,
          "note": "Nia DaCosta's version didn't land for Sean."
        },
        {
          "title": "Ghostbusters: Afterlife",
          "year": 2021,
          "note": "Not good."
        },
        {
          "title": "Ghostbusters: Frozen Empire",
          "year": 2024,
          "note": "Also not good."
        },
        {
          "title": "Now You See Me: Now You Don't",
          "year": 2025,
          "note": "Flagged for the 10-year rule."
        },
        {
          "title": "Practical Magic 2",
          "year": 2026,
          "note": "Wasn't very good."
        }
      ]
    }
  ],
