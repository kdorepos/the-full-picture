      "teams": [
        {
          "host": "Mallory Rubin",
          "picks": [
            {
              "title": "Bull Durham",
              "year": 1988,
              "category": "Comedy",
              "note": "Mallory's white whale and one of her three favorite films ever; watched it five days straight in high school. Took it in comedy over drama or based-on-a-true-story."
            },
            {
              "title": "The Natural",
              "year": 1984,
              "category": "High concept",
              "note": "Argued in as high concept for the mythic Roy Hobbs and the lightning-struck Wonderboy bat."
            },
            {
              "title": "The Bad News Bears",
              "year": 1976,
              "category": "Kids movie",
              "note": "The original, not the Linklater remake or Breaking Training."
            },
            {
              "title": "61*",
              "year": 2001,
              "category": "Based on a true story",
              "note": "Billy Crystal's Maris/Mantle home-run chase; Barry Pepper as Maris. An HBO telefilm whose eligibility was debated, then allowed."
            },
            {
              "title": "Damn Yankees",
              "year": 1958,
              "category": "Wild card",
              "note": "Sniped what Sean had earmarked for high concept; soul-selling musical."
            },
            {
              "title": "42",
              "year": 2013,
              "category": "Drama",
              "note": "Her last pick; felt the Jackie Robinson film belonged in the draft."
            }
          ]
        },
        {
          "host": "Amanda Dobbins",
          "picks": [
            {
              "title": "Moneyball",
              "year": 2011,
              "category": "Drama",
              "note": "The romance of statistical analysis; a girl-dad movie with a great Brad Pitt."
            },
            {
              "title": "Eephus",
              "year": 2024,
              "category": "Comedy",
              "note": "A rec-league game that goes on and on; observational and funny, with real sadness underneath."
            },
            {
              "title": "Ed",
              "year": 1996,
              "category": "High concept",
              "note": "Matt LeBlanc and a baseball-playing chimp, drafted late off Sean's list; allowed as high concept."
            },
            {
              "title": "The Rookie",
              "year": 2002,
              "category": "Based on a true story",
              "note": "Dennis Quaid as 35-year-old rookie Jim Morris. Sentimental and Disney-fied, and it works."
            },
            {
              "title": "The Sandlot",
              "year": 1993,
              "category": "Kids movie",
              "note": "The category leader; Benny the Jet, Wendy Peffercorn."
            },
            {
              "title": "Good Will Hunting",
              "year": 1997,
              "category": "Wild card",
              "note": "Only tangentially baseball: the Carlton Fisk 'had to see about a girl' speech and the Little League bleachers."
            }
          ]
        },
        {
          "host": "Sean Fennessey",
          "picks": [
            {
              "title": "A League of Their Own",
              "year": 1992,
              "category": "Based on a true story",
              "note": "Snatched it at No. 3, the pick Amanda was hoping would come back to her."
            },
            {
              "title": "Everybody Wants Some!!",
              "year": 2016,
              "category": "Comedy",
              "note": "Linklater's college-baseball hangout movie; the most authentic dudes-rocking film."
            },
            {
              "title": "Sugar",
              "year": 2008,
              "category": "Drama",
              "note": "Boden and Fleck; the most realistic minor-league portrayal, really an immigration story."
            },
            {
              "title": "Rookie of the Year",
              "year": 1993,
              "category": "High concept",
              "note": "12-year-old throws 104 after a busted arm; Gary Busey coked out as Chet Steadman."
