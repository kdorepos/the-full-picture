    {
      "kind": "review",
      "heading": "‘Clayface’",
      "films": [
        {
          "title": "Clayface",
          "year": 2026,
          "note": "James Watkins directs a Mike Flanagan and Hossein Amini script. Awful first half, promising body-horror back nine; it never commits to Cronenberg or to a bright period noir. Blumhousing a superhero movie is a good idea."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The 10 Best Horror Movies of 2026",
      "note": "with Chris Ryan",
      "subject": "horror movies of 2026",
      "films": [
        {
          "title": "Obsession",
          "year": 2026,
          "note": "One of the unmistakable big six; in both hosts' top 25 of the year."
        },
        {
          "title": "Backrooms",
          "year": 2026,
          "note": "Kane Parsons smash; really a sci-fi psychological thriller. Web-origin iterating onto Max."
        },
        {
          "title": "Resident Evil",
          "year": 2026,
          "note": "Pure fun; a model for how to adapt a game."
        },
        {
          "title": "The Bone Temple",
          "year": 2026,
          "note": "Among the year's favorites."
        },
        {
          "title": "Teenage Sex and Death at Camp Miasma",
          "year": 2026,
          "note": "More comedy/romance/coming-of-age; an essential text on why horror is so popular."
        },
        {
          "title": "Send Help",
          "year": 2026,
          "note": "Sam Raimi; his least-horror horror film, more survival thriller."
        },
        {
          "title": "Whalefall",
          "year": 2026,
          "note": "Body-horror set pieces wrapped in a sci-fi coming-of-age drama."
        },
        {
          "title": "The Cycle",
          "year": 2026,
          "note": "Deborah Ann Woll plays a forensic anthropologist, directed by Jordan Downey. Slow burn into an explosive, practically staged final 30 minutes; CR's best of the batch."
        },
        {
          "title": "Hope",
          "year": 2026,
          "note": "Na Hong-jin; post-apocalyptic Korean chase/monster movie, more Cameron than Carpenter."
        },
        {
          "title": "Colony",
          "year": 2026,
          "note": "Yeon Sang-ho; hive-mind zombies move in unison, great choreography but too long."
        },
        {
          "title": "Never After Dark",
          "year": 2026,
          "note": "Dave Boyle; an elegant, perfectly constructed Japanese ghost story."
        },
        {
          "title": "Buddy",
          "year": 2026,
          "note": "Casper Kelly (Too Many Cooks); surreal killer-puppet slasher, a sleeper headed toward ~$30M."
        },
        {
          "title": "Her Private Hell",
          "year": 2026,
          "note": "Nicholas Winding Refn's giallo return; Sean loves it, CR calls it a perfume commercial."
        },
        {
          "title": "It Ends",
          "year": 2026,
          "note": "Alexander Ullom debut; coming-of-age road trip inside a Twilight Zone loop, a genuine Gen Z film."
        },
        {
          "title": "V/H/S Mixtape",
          "year": 2026,
          "note": "Lesser entry; the Gwar wraparound didn't cohere."
        },
        {
          "title": "Breeder",
          "year": 2026,
          "note": "Shudder; more comedy than horror, Dot-Marie Jones as a poodle breeder."
        },
        {
          "title": "Hollow Warrior",
          "year": 2026,
          "note": "Milly Shapiro, Shannon Sossamon; reliable throwback-80s one-hander on Shudder."
        },
        {
          "title": "Insidious",
          "year": 2026,
