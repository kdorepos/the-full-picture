{
  "slug": "the-ben-affleck-hall-of-fame-and-animals-plus-other-mommy-is",
  "title": "The Ben Affleck Hall of Fame and ‘Animals.’ Plus: ‘Other Mommy’ Is Jump-Scary and Silly",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-10-13",
  "runtimeMin": 127,
  "format": "Box-office news, then two cheap-but-watchable reviews (Rob Savage's 'Other Mommy' and Ben Affleck's Netflix 'Animals'), capped by a full-filmography Ben Affleck Hall of Fame.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The News",
      "films": [
        {
          "title": "Miami Vice 85",
          "note": "Kosinski reboot of the Mann series; Michael B. Jordan as Tubbs, Austin Butler as Crockett, script by Dan Gilroy. Chris Ryan's beat."
        },
        {
          "title": "The Social Reckoning",
          "year": 2026,
          "note": "Theatrical 'Social Network' sequel from Aaron Sorkin with Mikey Madison and Jeremy Allen White. Opened to $5.5M. 'Bomb status.'"
        },
        {
          "title": "Digger",
          "year": 2026,
          "note": "Iñárritu's big-budget flop (<$35M) with a loud online defense; the hosts' running case for a boomerang awards run."
        },
        {
          "title": "Heart of the Beast",
          "year": 2026,
          "note": "The 'Dog' movie; older-skewing, headed past $100M worldwide."
        },
        {
          "title": "Prime Time",
          "year": 2025,
          "note": "A24, Robert Pattinson; found its young audience."
        },
        {
          "title": "Resident Evil",
          "year": 2026,
          "note": "IP + horror doing exactly what it should."
        },
        {
          "title": "River",
          "year": 2027,
          "note": "Trailer ran before Other Mommy. Blumhouse slasher, Jane Levy and Jessica Rothe; Jan 15, 2027."
        },
        {
          "title": "Exorcist: Martyrs",
          "note": "Mike Flanagan's 5th Exorcist, pretending Believer didn't happen. Scarlett Johansson as Det. Kinderman, John Leguizamo; read as a direct sequel to Exorcist III."
        },
        {
          "title": "Paper Tiger",
          "note": "ScarJo skipped its Cannes premiere to shoot Exorcist: Martyrs."
        },
        {
          "title": "The Guest",
          "note": "Emma Cline adaptation; Sadie Sink, Lorene Scafaria directing."
        },
        {
          "title": "Hatchet",
          "note": "Netflix/Dark Scene France adaptation of the Gary Paulsen YA book; Jean-François Richet."
        },
        {
          "title": "Roofman",
          "year": 2025,
          "note": "Richet's last film; Channing Tatum, Kirsten Dunst."
        },
        {
          "title": "The Beatles",
          "year": 2028,
          "note": "Four films, one per Beatle, released on consecutive April 2028 weekends. Proposed order: Paul, George, Ringo, John."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "'Other Mommy'",
      "note": "Rob Savage · Blumhouse",
      "films": [
        {
          "title": "Other Mommy",
          "year": 2026,
          "note": "From Josh Malerman's 'Incidents Around the House.' Jessica Chastain, Jay Duplass, Dichen Lachman, Arian Moayed, Karen Allen. Won the weekend ($28M), D+ CinemaScore, not screened for critics. Sean swept up by the balloon and ball-pit set pieces; Amanda bored by cheap CGI, a Ghostbusters-y middle, and continuity errors (the cake changes flavor)."
        },
        {
          "title": "Poltergeist",
          "year": 1982,
          "note": "The template Sean kept thinking of (young girl tormented by a demon) until the film pivots to a trauma-explanation ending."
        },
        {
          "title": "Smile",
          "year": 2022,
          "note": "Cited as quietly influential on how horror is now cut and sound-designed."
        },
        {
          "title": "Ghostbusters",
          "year": 1984,
          "note": "'Boring Ghostbusters': Amanda on the Karen Allen middle section."
        },
        {
          "title": "Coraline",
          "year": 2009,
          "note": "Why it isn't 'Other Mother': the other-mother-across-the-portal premise already exists."
        },
        {
          "title": "Obsession",
          "year": 2025,
          "note": "The horror mega-hit (trailer attached to The Odyssey; ~$2B) that 'broke containment' and distorted what casual viewers expect from the genre."
        },
        {
          "title": "Backrooms",
          "year": 2025,
          "note": "The lesser-but-same market-distorting horror success."
        },
        {
          "title": "Verity",
          "year": 2025,
          "note": "Colleen Hoover adaptation; Josh Hartnett, Dakota Johnson, Anne Hathaway. Amanda: 'a Hitchcock movie' that works until the Hoover of it doesn't. Sean: trash."
        },
        {
          "title": "Love Hypothesis",
          "year": 2025,
          "note": "The streaming romance both concede landed with its audience."
        }
      ]
    },
    {
      "kind": "review",
      "heading": "'Animals'",
      "note": "Ben Affleck · Netflix",
      "films": [
        {
          "title": "Animals",
          "year": 2026,
          "note": "Affleck directs and stars as an L.A. mayoral candidate whose son is kidnapped. Kerry Washington, Gillian Anderson, Adriana Paz, Steven Yeun. The uncredited second 'High and Low' remake in a year; not good but fun, best when it's thinly veiled Affleck. Everyone but Affleck and Anderson miscast; frenetic streaming cutting, AI-assisted and it shows."
        },
        {
          "title": "High and Low",
          "year": 1963,
          "note": "Kurosawa's source; both remakes miss its point by making the target a public figure rather than an anonymous rich man."
        },
        {
          "title": "Highest 2 Lowest",
          "year": 2025,
          "note": "Spike Lee's remake from last year; Sean rates it the better film despite the home-viewing backlash."
        },
        {
          "title": "Gone Girl",
          "year": 2014,
          "note": "The magnum opus of the Affleck study: 'we already have Gone Girl.'"
        },
        {
          "title": "The Super Mario Bros. Movie",
          "year": 2023,
          "note": "Cited for the swipe-up TikTok-edit pacing creeping into movies."
        },
        {
          "title": "Forgotten Island",
          "note": "Another recent example of that swarming, frenetic cutting style."
        },
        {
          "title": "The 14th",
          "note": "Ava DuVernay's NYFF premiere, under fire for AI-animated archival photos."
        },
        {
          "title": "The Brutalist",
          "year": 2024,
          "note": "Where the AI-in-movies conversation started for them."
        }
      ]
    },
    {
      "kind": "halloffame",
      "heading": "The Ben Affleck Hall of Fame",
      "honoree": "Ben Affleck",
      "films": [
        {
          "title": "Dazed and Confused",
          "year": 1993,
          "note": "Fred O'Bannion. Linklater seeing something in Affleck he didn't yet see in himself."
        },
        {
          "title": "Chasing Amy",
          "year": 1997,
          "note": "Holden McNeil. His first real acting showcase and the best deliverer of Kevin Smith dialogue. The director's commentary is a falling-in-love moment."
        },
        {
          "title": "Good Will Hunting",
          "year": 1997,
          "note": "Chuckie, and the 'best part of my day' speech. Co-writer; 30 years of Matt and Ben."
        },
        {
          "title": "Armageddon",
          "year": 1998,
          "note": "A.J. Frost. Home of the director's commentary that takes apart the film's own premise."
        },
        {
          "title": "Gone Baby Gone",
          "year": 2007,
          "note": "The directorial debut that reset the whole career."
        },
        {
          "title": "The Town",
          "year": 2010,
          "note": "Doug MacRay. Writes, directs, stars; a banger with one of the great final set pieces."
        },
        {
          "title": "Argo",
          "year": 2012,
          "note": "Best Picture winner, back to the hostage well. All-quadrant, endlessly rewatchable."
        },
        {
          "title": "Gone Girl",
          "year": 2014,
          "note": "Nick Dunne, the perfect text about Ben Affleck. The greenest green."
        },
        {
          "title": "The Accountant",
          "year": 2016,
          "note": "A real, different performance and a huge hit."
        },
        {
          "title": "Triple Frontier",
          "year": 2019,
          "note": "Honored on principle: 'when the Metallica hits.'"
        },
        {
          "title": "Dogma",
          "year": 1999,
          "note": "Bartleby. Amanda's blue pick: some of his best acting, in a mainstream comedy jousting with faith."
        },
        {
          "title": "The Greatest Love Story Never Told",
          "year": 2024,
          "note": "Sean's blue pick: Affleck turning on as his own self-aware documentarian, explaining lenses to J.Lo."
        }
      ]
    }
  ],
