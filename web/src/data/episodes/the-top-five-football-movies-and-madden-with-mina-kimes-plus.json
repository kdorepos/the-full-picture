{
  "slug": "the-top-five-football-movies-and-madden-with-mina-kimes-plus",
  "title": "The Top Five Football Movies and ‘Madden’ With Mina Kimes. Plus: The Intriguing International Film Race With Tracy Letts!",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins",
