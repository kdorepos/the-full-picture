{
  "slug": "old-movies-vs-new-movies-how-avengers-endgame-encore-beat-br",
  "title": "Old Movies vs. New Movies: How ‘Avengers: Endgame Encore’ Beat Brad Pitt, Robert Pattinson, and an Awesome Weekend Movie Lineup",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-09-28",
  "runtimeMin": 140,
  "format": "Old vs. new: a stacked weekend of originals gets flattened by a seven-year-old re-release, then John Wilson on his concrete documentary.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "The Weekend at the Movies",
      "note": "old vs. new, and the re-release that won the weekend",
      "films": [
        {
          "title": "Avengers: Endgame",
          "year": 2019,
          "note": "Re-released as 'Endgame Encore' in 'Infinity Vision,' a PLF up-charge that looked and sounded the same. Won the weekend at $26M. Four new end-tags (Loki at Peggy's door, a TVA timeline war, Ruffalo/Hulk, a Doom sigil) undo the Cap and Iron Man send-offs to set up 'Doomsday.'"
        },
        {
          "title": "Heart of the Beast",
          "year": 2026,
          "note": "David Ayer's Brad Pitt-and-his-dog Alaskan survival thriller with J.K. Simmons. $20M. Competent and grim; Sheridan-coded. Pitt is on autopilot except for one scene with the dog; the four German shepherds get the applause. Reported tug-of-war between Ayer's action cut and the Pitt/Chazelle cut."
        },
        {
          "title": "Forgotten Island",
          "year": 2026,
          "note": "DreamWorks original rooted in Filipino mythology; two teen girls stranded in Nicali. Post-Spider-Verse hyperactivity: manic, scary for little kids, with a memory-demon villain (Jenny Slate). The friendship core lands; everything else is ratatat. Weekend disappointment at $12M."
        },
        {
          "title": "Your Mother, Your Mother, Your Mother",
          "year": 2026,
          "note": "Bassam Tariq's post-'Blade' movie: Mahershala Ali as a devout hitman crossing Houston to find breast milk for his kids after his wife dies. Samurai-assassin action stitched to a raw parenting drama; John Cho broad and funny. The family half hits harder than the villain."
        },
        {
          "title": "The Weight",
          "year": 2026,
          "note": "Patrick McKinley's Depression-era thriller: Ethan Hawke and Russell Crowe smuggle gold 100 miles through the wilderness. Solid and Sorcerer-flavored, with strong period detail. Hawke stuck in anguish mode; the tacked-on daughter subplot drags."
        },
        {
          "title": "The Love Hypothesis",
          "year": 2026,
          "note": "Claire Scanlon's fanfic-to-streaming rom-com (Reylo origins), straight to Amazon. Lili Reinhart and Tom Bateman as scientists in a fake relationship. Charming leads, but overlong, badly written, cast a decade too old for 'PhD students.' Enough here for a 42-minute episode."
        },
        {
          "title": "The History of Concrete",
          "year": 2026,
          "note": "John Wilson's first feature doc, expanding after a strong single-theater run. A Hallmark screenwriting workshop applied to a movie about our oldest building material; wry, human-scaled, built on the people he finds."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "In conversation",
      "guest": "John Wilson on",
      "films": [
        {
          "title": "The History of Concrete",
          "year": 2026,
          "note": "Wilson on Long Island, first-person doc as its own art, finding the meta 'struggle to fund it' frame a year in, and refusing to blur into fiction like his peers."
        },
        {
          "title": "One Night Only",
          "year": 2026,
          "note": "His last-great-thing pick, a New York rom-com in the lineage of 'Nick and Norah' and '200 Cigarettes.'"
        }
      ]
    }
  ],
