  "runtimeMin": 181,
  "format": "Sean, Amanda, and Tracy Letts watch nearly all 75 Hackman features, grade each red/yellow/green, and induct ten. Three personal \"blues\" along the way.",
  "segments": [
    {
      "kind": "halloffame",
      "heading": "The Gene Hackman Hall of Fame",
      "honoree": "Gene Hackman",
      "films": [
        {
          "title": "Bonnie and Clyde",
          "year": 1967,
          "note": "Buck Barrow, the dumb older brother; first of five Oscar nods. The shoot he thought moviemaking would always be."
        },
        {
          "title": "The French Connection",
          "year": 1971,
          "note": "Popeye Doyle. Was somewhere between the 8th and 14th choice; won the Oscar and became a 30-year star. Changed American movies."
        },
        {
          "title": "Scarecrow",
          "year": 1973,
          "note": "Max the drifter opposite Pacino. Palme d'Or; devastating."
        },
        {
          "title": "The Conversation",
          "year": 1974,
          "note": "Harry Caul. The film got a Best Picture nod and he wasn't even nominated. A shriveled-up inner life carried almost without dialogue."
        },
        {
          "title": "Night Moves",
          "year": 1975,
          "note": "Harry Mosby. Bombed a week before Jaws; a great anti-mystery that rewards rewatching."
        },
        {
          "title": "Superman",
          "year": 1978,
          "note": "Lex Luthor. The broad, absurd villain register that defined his late-career comedy."
        },
        {
          "title": "Unforgiven",
          "year": 1992,
          "note": "Little Bill Daggett. A film he didn't want to make after swearing off violence; won his second Oscar. World-class."
        },
        {
          "title": "The Firm",
          "year": 1993,
          "note": "Avery Tolar. Sean and Amanda's sentimental green over Tracy's shrug; the emotional depth the thriller otherwise lacks."
        },
        {
          "title": "Crimson Tide",
          "year": 1995,
          "note": "Capt. Ramsey opposite Denzel. Sean fought for it, Tracy hated the coda; the commandeering scene carries it in."
        },
        {
          "title": "The Royal Tenenbaums",
          "year": 2001,
          "note": "Royal. The friction between his register and Wes Anderson's style that later films lost. He hated making it."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The rest of the career",
      "note": "the reds, yellows, and three blues",
      "films": [
        {
          "title": "Mad Dog Coll",
          "year": 1961,
          "note": "Uncredited cop; big-screen debut alongside Telly Savalas's."
        },
        {
          "title": "Lilith",
          "year": 1964,
          "note": "One scene as Jessica Walter's husband; how Warren Beatty first clocked him."
        },
        {
          "title": "Hawaii",
          "year": 1966,
          "note": "Angry island doctor; two scenes, steals them from Max von Sydow."
        },
        {
          "title": "Banning",
          "year": 1967,
          "note": "Golf-club drunk. 'Golf noir' that should have been more fun."
        },
        {
          "title": "A Covenant with Death",
          "year": 1967,
          "note": "Police chief; his single worst performance, doing an accent he shouldn't."
        },
        {
          "title": "First to Fight",
          "year": 1967,
          "note": "Sergeant Tweed; first of eleven military men."
        },
        {
          "title": "The Split",
          "year": 1968,
          "note": "Dirty cop in a stacked heist; shows up late."
        },
        {
          "title": "Riot",
          "year": 1969,
          "note": "Prisoner Red Fraker opposite Jim Brown again."
        },
        {
          "title": "The Gypsy Moths",
          "year": 1969,
          "note": "Barnstorming skydiver; the ground story beats the air."
        },
        {
          "title": "Downhill Racer",
          "year": 1969,
          "note": "Redford's ski coach; a value-add, not a lead."
        },
        {
          "title": "Marooned",
          "year": 1969,
          "note": "Astronaut Buzz; a long dud."
        },
        {
          "title": "I Never Sang for My Father",
          "year": 1970,
          "note": "Yellow. Oscar-nominated son in open-therapy mode; category fraud as supporting when he's in every frame."
        },
        {
          "title": "Doctors' Wives",
          "year": 1971,
          "note": "One of the doctors; trashy and dull."
        },
        {
          "title": "The Hunting Party",
          "year": 1971,
          "note": "Cattle-baron sniper; mean-spirited post-Wild Bunch Western."
        },
        {
          "title": "Prime Cut",
          "year": 1972,
          "note": "Human-trafficking cattle baron; one-note villainy, unforgettable images."
        },
        {
          "title": "The Poseidon Adventure",
          "year": 1972,
          "note": "Yellow. Heroic reverend; he later called it a 'money gig.'"
        },
        {
          "title": "Cisco Pike",
          "year": 1972,
          "note": "Coked-up cop blackmailing Kristofferson; a pre-Inherent Vice hang."
        },
        {
          "title": "Young Frankenstein",
          "year": 1974,
          "note": "Yellow. Blind hermit, one day's work, broke the crew improvising."
        },
        {
          "title": "Zandy's Bride",
          "year": 1974,
          "note": "Mean frontier farmer who mail-orders Liv Ullmann; fights a real bear."
        },
        {
          "title": "The French Connection II",
          "year": 1975,
          "note": "A money-grab sequel; garbage next to the original."
        },
        {
          "title": "Lucky Lady",
          "year": 1975,
          "note": "Rum-runner with Minnelli and Reynolds; a steaming dud."
        },
        {
          "title": "Bite the Bullet",
          "year": 1975,
          "note": "Tracy's blue. Turn-of-the-century endurance horse race; shambolic but great character moments."
        },
        {
          "title": "The Domino Principle",
          "year": 1977,
          "note": "Prisoner-assassin; the paycheck that reportedly cost him Cuckoo's Nest, Jaws, and Close Encounters."
        },
        {
          "title": "A Bridge Too Far",
          "year": 1977,
          "note": "Small military role in an overstuffed dud."
        },
        {
          "title": "March or Die",
          "year": 1977,
          "note": "Legionnaire; the third 1977 dud."
        },
        {
          "title": "Superman II",
          "year": 1980,
          "note": "Lex again; quit after Donner was fired, so he's shot from behind and dubbed."
        },
        {
          "title": "All Night Long",
          "year": 1981,
          "note": "Demoted drugstore manager; a strange Streisand paycheck curio."
        },
        {
          "title": "Reds",
          "year": 1981,
          "note": "Pete Van Wherry; one favor stretched to nine days, never worked with Beatty again."
        },
        {
          "title": "Under Fire",
          "year": 1983,
          "note": "TV anchor in Nicaragua; shaggy but solid."
        },
        {
          "title": "Uncommon Valor",
          "year": 1983,
          "note": "Father raising a private force for Laos; a basic shoot-'em-up."
        },
        {
          "title": "Eureka",
          "year": 1983,
          "note": "Gold-miner billionaire; the first 45 minutes astonishing, a There Will Be Blood ancestor."
        },
        {
          "title": "Misunderstood",
          "year": 1984,
          "note": "Maudlin shipping magnate in Egypt; out-acted by young Henry Thomas."
        },
        {
          "title": "Two of a Kind",
          "year": 1983,
          "note": "Uncredited voice of God; skipped."
        },
        {
          "title": "Twice in a Lifetime",
          "year": 1985,
          "note": "Factory worker who leaves his wife for Ann-Margret; a have-your-cake divorce drama."
        },
        {
          "title": "Target",
          "year": 1985,
          "note": "Secret ex-CIA dad; implausible third act."
        },
        {
          "title": "Power",
          "year": 1986,
          "note": "Political consultant; a baffling Sidney Lumet stinker."
        },
        {
          "title": "Hoosiers",
          "year": 1986,
          "note": "Yellow. Coach Dale; foundational to his legacy if not to theirs."
        },
        {
          "title": "No Way Out",
          "year": 1987,
          "note": "Amanda's blue. Horndog-murderer Secretary of Defense; the start of the horny-Hackman era."
        },
        {
          "title": "Superman IV: The Quest for Peace",
          "year": 1987,
          "note": "Lex plus the voice of Nuclear Man; a franchise-ending bomb."
        },
        {
          "title": "Bat 21",
          "year": 1988,
          "note": "Downed officer tracked via a golf metaphor; a stiff piece of ham."
        },
        {
          "title": "Split Decisions",
          "year": 1988,
          "note": "Boxing dad and ex-cop; ruinous fight choreography."
        },
        {
          "title": "Another Woman",
          "year": 1988,
          "note": "Rowlands's old flame for Woody Allen; subtle, excellent, easy masculinity."
        },
        {
          "title": "Full Moon in Blue Water",
          "year": 1988,
          "note": "Grieving bar owner opposite Teri Garr; a decent, stagebound hang."
        },
        {
          "title": "Mississippi Burning",
          "year": 1988,
          "note": "Yellow. FBI agent who 'knows Mississippi'; Oscar-nominated, centers the white men."
        },
        {
          "title": "The Package",
          "year": 1989,
          "note": "Sergeant chasing Tommy Lee Jones through Chicago; fun."
        },
        {
          "title": "Loose Cannons",
          "year": 1990,
          "note": "Cop saddled with Aykroyd's voices; possibly his worst."
        },
        {
          "title": "Postcards from the Edge",
          "year": 1990,
          "note": "Director modeled on Richard Donner; nails eight minutes."
        },
        {
          "title": "Narrow Margin",
          "year": 1990,
          "note": "Attorney guarding a witness aboard a train."
        },
        {
          "title": "Class Action",
          "year": 1991,
          "note": "Crusading attorney against his lawyer daughter; forgettable."
        },
        {
          "title": "Company Business",
          "year": 1991,
          "note": "CIA man with Baryshnikov; so forgettable you forget you watched it."
        },
        {
          "title": "Geronimo: An American Legend",
          "year": 1993,
          "note": "Military man; claims a native POV it never delivers."
        },
        {
          "title": "Wyatt Earp",
          "year": 1994,
          "note": "The Earp patriarch; leaves early and never returns in an inert nine-hour film."
        },
        {
          "title": "The Quick and the Dead",
          "year": 1995,
          "note": "Villain Herod; the fastest draw on set, in it little."
        },
        {
          "title": "Get Shorty",
          "year": 1995,
          "note": "Sean's blue. Schlock producer Harry Zimm; broad-comedy joy."
        },
        {
          "title": "The Birdcage",
          "year": 1996,
          "note": "Yellow. Senator Keeley; third-act farce that still holds up."
        },
        {
          "title": "Extreme Measures",
          "year": 1996,
          "note": "Villain doctor; well-produced and bad."
        },
        {
          "title": "The Chamber",
          "year": 1996,
          "note": "KKK grandfather on death row; stinks."
        },
        {
          "title": "Absolute Power",
          "year": 1997,
          "note": "First turn as a murderous President; forgettable but a grand time."
        },
        {
          "title": "Twilight",
          "year": 1998,
          "note": "Aging movie star opposite Newman; muted."
        },
        {
          "title": "Antz",
          "year": 1998,
          "note": "General Mandible; a rare voice role."
        },
        {
          "title": "Enemy of the State",
          "year": 1998,
          "note": "Brill, all but Harry Caul under a new name; Tony Scott fun."
        },
        {
          "title": "Under Suspicion",
          "year": 2000,
          "note": "The only film he ever produced; a turkey that made about $85k."
        },
        {
          "title": "The Replacements",
          "year": 2000,
          "note": "Coach of a scab team; the movie is ungenerous to the real strikers."
        },
        {
          "title": "The Mexican",
          "year": 2001,
          "note": "A dud; didn't make the Julia Roberts hall either."
        },
        {
          "title": "Heartbreakers",
          "year": 2001,
          "note": "About as broad as he ever got."
        },
        {
          "title": "Heist",
          "year": 2001,
          "note": "Blue-adjacent. Mamet thief nailing the Mamet-speak."
        },
        {
          "title": "Behind Enemy Lines",
          "year": 2001,
          "note": "Admiral; essentially Bat 21 again."
        },
        {
          "title": "Runaway Jury",
          "year": 2003,
          "note": "Jury consultant; first and last pairing with Dustin Hoffman, a dumb premise."
        },
        {
          "title": "Welcome to Mooseport",
          "year": 2004,
          "note": "Ex-President vs. Ray Romano; good in it, and his last film before walking away for good."
