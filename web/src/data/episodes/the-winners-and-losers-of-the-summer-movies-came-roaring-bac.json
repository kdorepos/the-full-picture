{
  "slug": "the-winners-and-losers-of-the-summer-movies-came-roaring-bac",
  "title": "The Winners and Losers of the Summer Movies Came Roaring Back. Plus: ‘Hope,’ ‘The Uprising,’ and 10 More We Missed.",
  "show": "The Big Picture",
  "network": "The Ringer",
  "hosts": [
    "Sean Fennessey",
    "Amanda Dobbins"
  ],
  "published": "2026-09-11",
  "runtimeMin": 181,
  "format": "Amanda's back from Venice. The two tally a record summer box office and grade their own busted prediction game, then run through the late-summer titles they caught up on. After that, Sean and Ben David Grabinski spend an hour on Abel Ferrara.",
  "segments": [
    {
      "kind": "discussion",
      "heading": "Movie news",
      "note": "reboots, remakes, and a Shyamalan-Sparks romance",
      "films": [
        {
          "title": "Remain",
          "year": 2027,
          "note": "M. Night Shyamalan supernatural romance co-written by Nicholas Sparks; Jake Gyllenhaal and Phoebe Dynevor. Punted from 2026."
        },
        {
          "title": "The Italian Job",
          "year": 2003,
          "note": "Paul Feig attached to a new version; neither host has seen this one."
        },
        {
          "title": "Get Smart",
          "year": 2008,
          "note": "The Carell-Hathaway remake; cited as a dud they confuse with Date Night."
        },
        {
          "title": "Date Night",
          "year": 2010,
          "note": "Carell and Fey; the movie their memories keep merging with Get Smart."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The winners and losers of the summer",
      "note": "a record $4.76B season",
      "films": [
        {
          "title": "Spider-Man: Brand New Day",
          "year": 2026,
          "note": "$2.4B worldwide, $923M domestic. The everyone-movie: kids and adults both. Neither guessed near it."
        },
        {
          "title": "The Odyssey",
          "year": 2026,
          "note": "Nolan's biggest, $1.63B; highest-grossing R-rated and IMAX release ever. $289M from IMAX."
        },
        {
          "title": "Michael",
          "year": 2026,
          "note": "Bad pre-release press, still $1B worldwide and Lionsgate's biggest. First billion-dollar biopic; Jafar Jackson delivers."
        },
        {
          "title": "Obsession",
          "year": 2026,
          "note": "Curry Barker's $750K horror made $512M worldwide off no stars. Breakout turn from Indy Navarrete. The season's real shock."
        },
        {
          "title": "Backrooms",
          "year": 2026,
          "note": "Kane Parsons; $394M. A YouTube-lore IP for a generation that isn't them."
        },
        {
          "title": "Iron Lung",
          "year": 2026,
          "note": "Markiplier self-distributed it to $50M-plus off pure fan demand."
        },
        {
          "title": "Coyote vs. Acme",
          "year": 2026,
          "note": "Fans forced Warner Bros. to release it; headed for $50M-plus."
        },
        {
          "title": "The Invite",
          "year": 2026,
          "note": "Smaller title that just did good business and stuck with people."
        },
        {
          "title": "The Sheep Detectives",
          "year": 2026,
          "note": "Another modest hit that justified itself."
        },
        {
          "title": "The Devil Wears Prada 2",
          "year": 2026,
          "note": "$700M worldwide on a two-month photo-call tour. Underserved audience: women who like to have fun."
        },
        {
          "title": "Toy Story 5",
          "year": 2026,
          "note": "Roughly a billion; third-highest Pixar ever. A Jessie movie. Sean liked it more than Amanda."
        },
        {
          "title": "Moana",
          "year": 2026,
          "note": "Live-action bomb, $315M worldwide. Sean's biggest prediction miss and maybe the end of Disney live-action."
        },
        {
          "title": "Minions and Monsters",
          "year": 2026,
          "note": "$518M reads as failure only against a franchise that clears $900M a pop; still profitable on ~$85M."
        },
        {
          "title": "The Mandalorian and Grogu",
          "year": 2026,
          "note": "$178M. Underperformance that felt like closing the TV-era chapter of Star Wars."
        },
        {
          "title": "Supergirl",
          "year": 2026,
          "note": "$126M. Tier-two superhero movies don't work; emblematic of a brutal Warner Bros. summer."
        },
        {
          "title": "Masters of the Universe",
          "year": 2026,
          "note": "$113M theatrical bomb, then a top Amazon streaming debut. Poses whether a streaming-only sequel makes more sense."
        },
        {
          "title": "Look Back",
          "year": 2026,
          "note": "Live-action anime adaptation; Amanda saw it at Venice and hated the energy drop from the animation."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "The summer movie preview game",
      "note": "box-office and Metacritic predictions, tallied",
      "films": [
        {
          "title": "Disclosure Day",
          "year": 2026,
          "note": "Sean nailed it cold: 74 Metacritic and $121M guessed against 74 and $117M actual."
        },
        {
          "title": "Billie Eilish: Hit Me Hard and Soft - The Tour",
          "year": 2026,
          "note": "Amanda's big miss at $160M; it made $9.9M. Big Jim finally missed."
        },
        {
          "title": "Power Ballad",
          "year": 2026,
          "note": "Guesses of $26M and $16M; made $2.6M."
        },
        {
          "title": "Jackass: Best and Last",
          "year": 2026,
          "note": "A clip reel; overshot at $81M and $60M, made $18M."
        },
        {
          "title": "One Night Only",
          "year": 2026,
          "note": "Guessed $76M and $38M; made $11.5M. Also torched Sean's fantasy league."
        },
        {
          "title": "Super Troopers 3",
          "year": 2026,
          "note": "Guessed $48M and $22M; made $7M."
        }
      ]
    },
    {
      "kind": "discussion",
      "heading": "'Hope,' 'The Uprising,' and 10 more we missed",
      "note": "late-summer catch-up",
      "films": [
        {
          "title": "The Uprising",
          "year": 2026,
          "note": "Paul Greengrass; Andrew Garfield as Plowman in the 1381 peasants' revolt. Electric first hour, then CGI crowds and third-act problems sink it."
        },
        {
          "title": "Hope",
          "year": 2026,
          "note": "Na Hong-jin's Korean creature epic. A near-hour of unseen-monster chase draws applause, then the aliens (Fassbender, Vikander, Russell) show up in terrible CGI. Redeems itself with a practical highway climax."
        },
        {
          "title": "Mayday",
          "year": 2026,
          "note": "Daley and Goldstein; Ryan Reynolds and Kenneth Branagh. A jingoistic Top Gun riff whose earnestness clashes with Reynolds's smarm. Nobody could figure out why it exists."
        },
        {
          "title": "One Night Only",
          "year": 2026,
          "note": "Will Gluck's 'sex purge' rom-com with the sex removed. Barbaro and Turner are cute; the premise goes unexplored and the whole thing misfires."
        },
        {
          "title": "Idiots",
          "year": 2026,
          "note": "Macon Blair; O'Shea Jackson Jr. and Dave Franco drive a rich teen to rehab. Closer to The Last Detail than Midnight Run; wanted it funnier. Formerly titled Shitheads."
        },
        {
          "title": "Buddy",
          "year": 2026,
          "note": "Caspar Kelly's killer-kids-show puppet horror. First 40 minutes inside the recreated 1994 show are perfect; teaser-only marketing made it a sleeper hit."
        },
        {
          "title": "The Rivals of Amziah King",
          "year": 2026,
          "note": "Andrew Patterson's first since The Vast of Night; McConaughey as a beekeeping bluegrass patriarch. Wild, funny first half topples into a flat revenge movie."
        },
        {
          "title": "The Wrong Girls",
          "year": 2026,
          "note": "Dylan Meyer directs Kristen Stewart. Worth discussing, Sean's unsure it's worth recommending; Amanda hasn't seen it."
        },
        {
          "title": "Practical Magic 2",
          "year": 2026,
          "note": "Weekend's other big title, held for next week's episode."
        }
      ]
    },
    {
      "kind": "interview",
      "heading": "Abel Ferrara, with Ben David Grabinski",
      "note": "on the new Criterion Channel collection Sean helped curate",
      "guest": "Ben David Grabinski on",
      "films": [
        {
          "title": "King of New York",
          "year": 1990,
          "note": "Both call it his masterpiece. Fishburne's gravity, the Walken hotel scene, Bozelli's lighting. Ferrara wrote it as his Terminator."
        },
        {
          "title": "Bad Lieutenant",
          "year": 1992,
          "note": "A deeply Catholic film; the Keitel part almost went to Walken. Set against a fictional Mets comeback."
        },
        {
          "title": "Ms. 45",
          "year": 1981,
          "note": "Grabinski's near-favorite; a silent-star-caliber lead performance and an exultant revenge romp."
        },
        {
          "title": "The Addiction",
          "year": 1995,
          "note": "Kelsch's handheld black-and-white; a vampire film as heroin allegory. A top-five vampire movie for Sean."
        },
        {
          "title": "China Girl",
          "year": 1987,
          "note": "Ferrara's West Side Story in Little Italy/Chinatown, really about a boss who doesn't care about you. Needs a 4K."
        },
        {
          "title": "Body Snatchers",
          "year": 1993,
          "note": "His studio scale-up for Warner Bros.; tested badly and burned him. Grabinski's underrated-90s-genre pick."
        },
        {
          "title": "The Blackout",
          "year": 1997,
          "note": "One of the bleakest movies either has seen; part-VHS, ripped from Ferrara's own life. Dennis Hopper in Frank Booth mode."
        },
        {
          "title": "New Rose Hotel",
          "year": 1998,
          "note": "A seven-page Gibson story stretched to pure mood; last Ferrara-Walken pairing, first with Dafoe. Replays scenes with different takes."
        },
        {
          "title": "Zeros and Ones",
          "year": 2021,
          "note": "Sean Price Williams DV; Grabinski's late-period favorite, 'the closest we've gotten to Metal Gear Solid 2 in a movie.'"
        },
        {
          "title": "Tommaso",
          "year": 2019,
          "note": "Sean's late-period masterpiece; Dafoe as a Ferrara stand-in wrestling with God."
        },
        {
          "title": "Welcome to New York",
          "year": 2014,
          "note": "Depardieu as a DSK figure. The edited iTunes cut guts the POV; the uncut version is in the collection."
        },
        {
          "title": "Dangerous Game",
          "year": 1993,
          "note": "Written around Madonna, then pivoted to Keitel's filmmaker; shaggy, both too long and too short."
        },
        {
          "title": "Pasolini",
          "year": 2014,
          "note": "Willem Dafoe again; interesting but not the pick over Tommaso."
        },
        {
          "title": "The Funeral",
          "year": 1996,
          "note": "Chris Penn's performance freaks Grabinski out more than Henry does; a very bad hang."
        },
        {
          "title": "The Driller Killer",
          "year": 1979,
          "note": "His dirtbag era; a Texas Chainsaw-inspired attempt to make money on horror."
        },
        {
          "title": "Nine Lives of a Wet Pussycat",
          "year": 1976,
          "note": "His first feature, a porno."
        },
        {
          "title": "Cat Chaser",
          "year": 1989,
          "note": "An Elmore Leonard adaptation with Peter Weller he wasn't happy with."
        },
        {
          "title": "Fear City",
          "year": 1984,
          "note": "Berenger and a Billy Dee Williams role that never becomes the buddy movie it teases. Song title: 'Method to Your Badness.'"
        },
        {
          "title": "Mary",
          "year": 2005,
          "note": "Not in the collection and hard to find."
        },
        {
          "title": "Go Go Tales",
          "year": 2007,
          "note": "The single hardest of his films to track down; not in the package."
        },
        {
          "title": "Alive in France",
          "year": 2017,
          "note": "Documentary of Ferrara screening films and performing music in Europe."
        }
      ]
    }
  ],
